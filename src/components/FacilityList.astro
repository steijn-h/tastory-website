---
// Voorzieningen en dieetwensen als tegeltjes met een icoon, op de
// restaurantpagina. Onbekende waarden krijgen een vinkje.
interface Props {
  items: string[];
}
const { items } = Astro.props;

// Lijntekeningen (24×24, stroke), in de stijl van de andere iconen op de site.
const ICONS: [RegExp, string][] = [
  [
    /reserv/i,
    '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M9 16l2 2 4-4"/>',
  ],
  [
    /rolstoel|toegankelijk/i,
    '<circle cx="12" cy="4" r="1.6"/><path d="M12 7v6h5l2 5"/><path d="M12 10h4"/><path d="M8.5 10.6A5.5 5.5 0 1 0 16 18"/>',
  ],
  [
    /parkeer|parkeren/i,
    '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 17V7h4a3 3 0 0 1 0 6H9"/>',
  ],
  [/terras/i, '<path d="M12 3v18M7 21h10"/><path d="M3 9a9 6 0 0 1 18 0z"/>'],
  [
    /vegan|vegetar/i,
    '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10z"/><path d="M2 21c0-3 1.9-5.4 5.2-6.1 2.4-.5 4.9-2 5.8-3.9"/>',
  ],
  [
    /gluten/i,
    '<path d="M2 22 16 8"/><path d="M3.5 12.5 5 11l1.5 1.5a3.5 3.5 0 0 1 0 5L5 19l-1.5-1.5a3.5 3.5 0 0 1 0-5z"/><path d="M7.5 8.5 9 7l1.5 1.5a3.5 3.5 0 0 1 0 5L9 15l-1.5-1.5a3.5 3.5 0 0 1 0-5z"/><path d="M11.5 4.5 13 3l1.5 1.5a3.5 3.5 0 0 1 0 5L13 11l-1.5-1.5a3.5 3.5 0 0 1 0-5z"/><path d="M20 2h2v2a4 4 0 0 1-4 4h-2V6a4 4 0 0 1 4-4z"/>',
  ],
  [
    /lactose|melk/i,
    '<path d="M8 2h8M9 2v3l-2 4v11a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9l-2-4V2"/><path d="M7 13h10"/>',
  ],
  [
    /ei-vrij|eivrij|\bei\b/i,
    '<path d="M12 22c4.4 0 7-3.1 7-7.5S15.9 2 12 2 5 10.1 5 14.5 7.6 22 12 22z"/>',
  ],
  [
    /noten|pinda/i,
    '<path d="M12 4c-3 0-6 2.5-6 7 0 4 2.5 9 6 9s6-5 6-9c0-4.5-3-7-6-7z"/><path d="M9 9h6M8.5 13h7M9.5 17h5"/>',
  ],
  [
    /wifi/i,
    '<path d="M5 12.6a10 10 0 0 1 14 0M8.5 16.1a5 5 0 0 1 7 0M2 8.8a15 15 0 0 1 20 0"/><circle cx="12" cy="20" r="1"/>',
  ],
  [/kind/i, '<circle cx="12" cy="5" r="2.5"/><path d="M8 22v-6l-2-5 6-2 6 2-2 5v6M10 22v-4h4v4"/>'],
  [
    /hond|huisdier/i,
    '<path d="M10 5.2C10 3.9 8.9 3 7.5 3S5 3.9 5 5.2c0 1.2.5 2.1 1 3M14 5.2c0-1.3 1.1-2.2 2.5-2.2S19 3.9 19 5.2c0 1.2-.5 2.1-1 3"/><path d="M6 10c0 6 2.7 11 6 11s6-5 6-11c0-2-2.7-3-6-3s-6 1-6 3z"/>',
  ],
];
const CHECK = '<circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/>';
const iconFor = (label: string) => ICONS.find(([re]) => re.test(label))?.[1] ?? CHECK;
---

<ul class="facilities">
  {
    items.map((label) => (
      <li>
        <span class="icon" aria-hidden="true">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={iconFor(label)}
          />
        </span>
        {label}
      </li>
    ))
  }
</ul>

<style>
  .facilities {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    margin-top: 0.4rem;
  }
  .facilities li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.6rem;
    background: rgba(255, 142, 62, 0.07);
    border: 1px solid rgba(255, 142, 62, 0.22);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--text);
    line-height: 1.2;
  }
  .icon {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--white);
    color: var(--orange-dark);
  }
</style>
