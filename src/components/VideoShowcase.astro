---
// Rij met restaurants die een video hebben (zelfde bron als de video-sectie in
// de app). Dezelfde kaartjes als in de lijsten, zodat het blok bij de rest van
// de site past; de video speelt in het kaartje bij aanwijzen met de muis.
import RestaurantCard from './RestaurantCard.astro';
import { hasVideo, type RestaurantListItem } from '../lib/restaurants';

interface Props {
  restaurants: RestaurantListItem[];
  title?: string;
  /** Kaartjes in het midden (homepage) i.p.v. links uitgelijnd. */
  center?: boolean;
}
const { restaurants, title = 'Restaurants met video', center = false } = Astro.props;
const items = restaurants.filter(hasVideo).slice(0, 12);
---

{
  items.length > 0 && (
    <section class:list={['showcase', { center }]} aria-label={title}>
      <h2>{title}</h2>
      <ul class="row">
        {items.map((r) => (
          <li>
            <RestaurantCard restaurant={r} />
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  /* global.css geeft elke <section> veel padding (marketingpagina's). */
  .showcase {
    padding: 0;
    max-width: none;
    margin: var(--space-xl) 0 var(--space-2xl);
  }
  h2 {
    font-family: var(--serif);
    font-size: var(--text-xl);
    font-weight: 500;
    color: var(--text);
    margin-bottom: var(--space-md);
  }
  .center h2 {
    text-align: center;
  }
  /* Eén rij; bij meer video's horizontaal scrollen. */
  .row {
    list-style: none;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(280px, calc((100% - 2 * var(--space-xl)) / 3));
    gap: var(--space-xl);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /* Ruimte voor de schaduw van de kaartjes (overflow knipt anders af). */
    padding: 6px 14px 32px;
    margin: -6px -14px -20px;
  }
  .center .row {
    justify-content: center;
    /* Past de rij niet, dan links beginnen i.p.v. kaartjes afknippen. */
    justify-content: safe center;
  }
  .row li {
    scroll-snap-align: start;
  }
  @media (max-width: 520px) {
    .row {
      grid-auto-columns: calc((100% - 12px) / 2);
      gap: 12px;
    }
  }
</style>
