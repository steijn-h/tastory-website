---
import RatingStars from './RatingStars.astro';
import { ASPECTS, type Review } from '../lib/restaurants';
import { formatReviewDate } from '../lib/format';

interface Props {
  review: Review;
}
const { review } = Astro.props;

// Zelfde verificatielabels als in de app.
const tier =
  review.verification_tier ??
  (review.gps_checked_in ? 'VERIFIED' : review.photo_verified ? 'SEMI' : null);
const badge =
  tier === 'VERIFIED'
    ? { text: 'Ter plaatse ✓', cls: 'verified', title: 'Geplaatst op locatie bij het restaurant' }
    : tier === 'SEMI'
      ? { text: 'Foto ✓', cls: 'semi', title: 'Bevestigd met een foto van het bezoek' }
      : { text: 'Niet geverifieerd', cls: 'none', title: 'Bezoek niet geverifieerd' };

const aspects = ASPECTS.flatMap(({ key, label }) => {
  const value = review[key];
  return typeof value === 'number' && value > 0 ? [{ label, value }] : [];
});
const date = formatReviewDate(review.created_at);
---

<article class="review">
  <header class="review-head">
    <div class="avatar" aria-hidden="true">
      {
        review.author.avatarUrl ? (
          <img src={review.author.avatarUrl} alt="" loading="lazy" width="40" height="40" />
        ) : (
          <span>{review.author.initial}</span>
        )
      }
    </div>
    <div class="meta">
      <span class="author">{review.author.name}</span>
      <div class="rating-row">
        {review.rating ? <RatingStars rating={review.rating} size={14} /> : null}
        {
          date && (
            <time class="date" datetime={review.created_at ?? undefined}>
              {date}
            </time>
          )
        }
      </div>
    </div>
    <span class={`badge ${badge.cls}`} title={badge.title}>{badge.text}</span>
  </header>

  {review.text && <p class="text">{review.text}</p>}

  {
    aspects.length > 0 && (
      <dl class="aspects">
        {aspects.map((a) => (
          <div class="aspect">
            <dt>{a.label}</dt>
            <dd>{a.value.toLocaleString('nl-NL', { maximumFractionDigits: 1 })}</dd>
          </div>
        ))}
      </dl>
    )
  }
</article>

<style>
  .review {
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--beige-deeper);
  }
  .review-head {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .avatar {
    flex: 0 0 40px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--brown);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 500;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .meta {
    flex: 1;
    min-width: 0;
  }
  .author {
    font-weight: 500;
    color: var(--text);
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .rating-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.15rem;
  }
  .date {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .badge {
    flex: 0 0 auto;
    font-size: var(--text-xs);
    font-weight: 500;
    padding: 0.2rem 0.55rem;
    border-radius: 100px;
    white-space: nowrap;
  }
  .badge.verified {
    background: rgba(26, 138, 80, 0.12);
    color: #146b3e;
  }
  .badge.semi {
    background: rgba(192, 90, 32, 0.1);
    color: #a34a18;
  }
  .badge.none {
    background: rgba(136, 130, 121, 0.12);
    color: var(--text-muted);
  }
  .text {
    margin-top: 0.75rem;
    line-height: 1.6;
    color: var(--text);
    white-space: pre-line;
    overflow-wrap: anywhere;
  }
  .aspects {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }
  .aspect {
    display: flex;
    gap: 0.35rem;
    font-size: var(--text-xs);
    background: var(--beige-dark);
    padding: 0.25rem 0.6rem;
    border-radius: 100px;
  }
  .aspect dt {
    color: var(--text-muted);
  }
  .aspect dd {
    font-weight: 500;
    color: var(--text);
  }
</style>
