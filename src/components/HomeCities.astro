---
// Links naar de stadspagina's vanaf de homepage: de homepage is de sterkste
// pagina van de site, en Google gebruikt interne links om te bepalen welke
// pagina's belangrijk zijn.
import SectionHeader from './SectionHeader.astro';
import VideoShowcase from './VideoShowcase.astro';
import Recommendations from './Recommendations.astro';
import { cityPath, getAllRestaurants, groupByCity } from '../lib/restaurants';
import { CITY_PHOTOS } from '../data/city-photos';

const all = await getAllRestaurants();
// Steden met minstens 5 restaurants, op alfabet (groupByCity sorteert al).
const cities = all ? groupByCity(all).filter((c) => c.restaurants.length >= 5) : [];
const credits = cities
  .map((c) => ({ city: c.name, photo: CITY_PHOTOS[c.slug] }))
  .filter((x) => x.photo);
const total = all?.length ?? 0;
---

{
  cities.length > 0 && (
    <section class="cities">
      <div class="recs-wrap" data-recs-center>
        <Recommendations center />
      </div>
      {all && (
        <div class="videos reveal">
          <VideoShowcase restaurants={all} center />
        </div>
      )}
      <div class="reveal">
        <SectionHeader
          tag="Restaurants ontdekken"
          title="Restaurants <em>per stad</em>"
          description={`Bekijk ${total} restaurants op Tastory, met foto's, menukaarten en reviews van gasten.`}
          center
        />
      </div>
      <ul class="city-list reveal">
        {cities.map((c) => {
          const photo = CITY_PHOTOS[c.slug];
          return (
            <li>
              <a href={cityPath(c.name)} class:list={['city', { 'no-photo': !photo }]}>
                {photo && (
                  <img
                    src={photo.src}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    width="640"
                    height="420"
                  />
                )}
                <span class="city-text">
                  <span class="city-name">{c.name}</span>
                  <span class="city-count">{c.restaurants.length} restaurants</span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
      <p class="all reveal">
        <a href="/restaurants">Alle restaurants en steden bekijken →</a>
      </p>
      {credits.length > 0 && (
        <p class="credits">
          Foto's via Wikimedia Commons:{' '}
          {credits.map((x, i) => (
            <>
              {i > 0 && ', '}
              <a href={x.photo!.source} target="_blank" rel="noopener noreferrer">
                {x.city}
              </a>{' '}
              ({x.photo!.author}, {x.photo!.license})
            </>
          ))}
        </p>
      )}
    </section>
  )
}

<style>
  .recs-wrap {
    max-width: 1080px;
    margin: 0 auto;
  }
  .videos {
    max-width: 1080px;
    margin: 0 auto var(--space-3xl);
  }
  .cities {
    padding-top: var(--space-3xl);
    padding-bottom: var(--space-3xl);
  }
  /* De omschrijving van SectionHeader heeft een max-breedte; centreren. */
  .cities :global(.section-desc) {
    margin-left: auto;
    margin-right: auto;
  }
  .city-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-md);
    max-width: 1080px;
    margin: var(--space-xl) auto 0;
  }
  .city {
    position: relative;
    display: flex;
    align-items: flex-end;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, var(--brown-light), var(--brown-dark));
    color: #fff;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.25s,
      box-shadow 0.25s;
  }
  .city img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }
  /* Donkere verloop onderaan zodat de naam altijd leesbaar is. */
  .city::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(30, 22, 15, 0.78), rgba(30, 22, 15, 0) 60%);
  }
  .city:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .city:hover img {
    transform: scale(1.05);
  }
  .city:focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: 3px;
  }
  .city-text {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    padding: 0.9rem 1rem;
  }
  .city-name {
    font-family: var(--serif);
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.15;
  }
  .city-count {
    font-size: var(--text-xs);
    opacity: 0.85;
  }
  @media (max-width: 520px) {
    .city-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
    .city-name {
      font-size: 1.1rem;
    }
    .city-text {
      padding: 0.7rem 0.8rem;
    }
  }
  .credits {
    max-width: 1080px;
    margin: var(--space-lg) auto 0;
    font-size: 0.7rem;
    line-height: 1.6;
    color: var(--text-muted);
    text-align: center;
  }
  .credits a {
    color: inherit;
  }
  .all {
    text-align: center;
    margin-top: var(--space-lg);
  }
  .all a {
    color: var(--brown);
    font-weight: 500;
  }
</style>
