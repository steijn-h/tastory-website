---
// Restaurantkaartje voor overzichten. Luxe maar rustig: een duidelijk kaartje
// met de foto in een smalle rand (passe-partout), de stad als kleine kop, de
// naam in de sierletter en keuken/prijs gedempt. Video als label op de foto;
// heeft een restaurant reviews, dan staat de score onder de naam.
import { hasVideo, restaurantPath, type RestaurantListItem } from '../lib/restaurants';
import { normalizeCity, priceLabel, priceRange, safeHttpsUrl, splitUrls } from '../lib/format';
import { imageSrcset, imageUrl } from '../lib/image';

interface Props {
  restaurant: RestaurantListItem;
  /** Bovenaan de pagina: foto direct laden (snellere eerste weergave). */
  priority?: boolean;
}
const { restaurant: r, priority = false } = Astro.props;
const photo = splitUrls(r.photo_url)[0] ?? null;
const city = normalizeCity(r.city);
const score = r.weighted_score && r.weighted_score > 0 ? Number(r.weighted_score) : null;
const reviewCount = r.published_review_count ?? 0;
// Geplaatst maar nog niet geverifieerd: telt mee in het aantal, niet in de score.
const pendingCount = r.pending_review_count ?? 0;
const totalReviews = reviewCount + pendingCount;
const video = hasVideo(r);
const videoUrl = video ? safeHttpsUrl(r.video_url) : null;
// Keuken, sfeer en prijs als losse stukjes die elk heel blijven (geen prijs
// die halverwege afbreekt). Sfeer kort houden: hooguit twee woorden.
const vibe = (r.vibe ?? '')
  .split(',')
  .map((v) => v.trim())
  .filter(Boolean)
  .slice(0, 2)
  .join(', ');
const details = [
  r.cuisine ? { text: r.cuisine, cls: 'cuisine' } : null,
  vibe ? { text: vibe, cls: 'vibe' } : null,
  r.price_level
    ? {
        text: `${priceLabel(r.price_level)} · ${priceRange(r.price_level).replace(' p.p.', '')}`,
        cls: 'price',
      }
    : null,
].filter((d): d is { text: string; cls: string } => d !== null);
const formattedScore = score?.toLocaleString('nl-NL', {
  minimumFractionDigits: 1,
  maximumFractionDigits: 1,
});
---

<a
  href={restaurantPath(r)}
  class:list={['card', { 'has-video': video }]}
  data-card-video={video ? '' : undefined}
>
  <div class="photo">
    {
      photo ? (
        <img
          src={imageUrl(photo, 640)}
          srcset={imageSrcset(photo, [480, 640])}
          sizes="(max-width: 520px) 50vw, (max-width: 1100px) 50vw, 380px"
          alt={r.name ?? ''}
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : undefined}
          decoding="async"
        />
      ) : (
        <div class="placeholder" />
      )
    }
    {
      videoUrl && (
        <video
          src={videoUrl}
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
          class="preview"
        />
      )
    }
    {
      video && (
        <span class="badge video">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7z" />
          </svg>
          Video
        </span>
      )
    }
  </div>
  <div class="body">
    {
      city && (
        <p class="city">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" />
          </svg>
          {city}
        </p>
      )
    }
    <h3 class="name">{r.name}</h3>
    {
      totalReviews > 0 && (
        <p
          class="rating"
          aria-label={`${formattedScore ? `Beoordeling ${formattedScore} van 5, ` : ''}${totalReviews} ${totalReviews === 1 ? 'review' : 'reviews'}`}
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" />
          </svg>
          {formattedScore && <strong>{formattedScore}</strong>}
          <span>
            {totalReviews} {totalReviews === 1 ? 'review' : 'reviews'}
            {!formattedScore && ' · nog niet geverifieerd'}
          </span>
        </p>
      )
    }
    {
      details.length > 0 && (
        <div class="details-wrap">
          <p class="details">
            {details.map((d) => (
              <span class={d.cls}>{d.text}</span>
            ))}
          </p>
        </div>
      )
    }
    <slot />
  </div>
</a>

<script>
  // Restaurants met video: op apparaten met een muis speelt de video in het
  // kaartje bij aanwijzen. preload="none": er laadt niets tot je aanwijst.
  const canPreview =
    window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (canPreview) {
    document.querySelectorAll<HTMLElement>('[data-card-video]').forEach((card) => {
      const video = card.querySelector<HTMLVideoElement>('video.preview');
      if (!video) return;
      card.addEventListener('mouseenter', () => {
        void video.play().then(
          () => card.classList.add('playing'),
          () => {},
        );
      });
      card.addEventListener('mouseleave', () => {
        card.classList.remove('playing');
        video.pause();
      });
    });
  }
</script>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 10px;
    background: var(--white);
    border: 1px solid rgba(136, 101, 69, 0.1);
    border-radius: 20px;
    box-shadow:
      0 1px 2px rgba(58, 46, 34, 0.04),
      0 10px 28px rgba(58, 46, 34, 0.06);
    text-decoration: none;
    color: inherit;
    transition:
      box-shadow 0.35s ease,
      border-color 0.35s ease;
  }
  .card:hover {
    border-color: rgba(136, 101, 69, 0.18);
    box-shadow:
      0 1px 2px rgba(58, 46, 34, 0.05),
      0 16px 40px rgba(58, 46, 34, 0.1);
  }
  .card:focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: 3px;
  }
  .photo {
    position: relative;
    aspect-ratio: 4 / 3;
    /* Zonder dit rekt een staande foto het vak op (ongelijke kaartjes). */
    overflow: hidden;
    border-radius: 12px;
    background: var(--beige-dark);
  }
  .photo img,
  .placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .photo img {
    transition: transform 0.8s cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .card:hover .photo img {
    transform: scale(1.04);
  }
  /* Video in het kaartje: onzichtbaar tot hij speelt. */
  /* Video in de eigen verhouding (niets afsnijden), op een donkere achtergrond. */
  .preview {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #1d1712;
    opacity: 0;
    transition: opacity 0.4s;
  }
  .card:global(.playing) .preview {
    opacity: 1;
  }
  /* Restaurants met video vallen op met een warme, gouden rand. */
  .card.has-video {
    border-color: rgba(201, 168, 76, 0.55);
    box-shadow:
      0 0 0 1px rgba(201, 168, 76, 0.25),
      0 10px 28px rgba(58, 46, 34, 0.08);
  }
  .card.has-video:hover {
    border-color: rgba(201, 168, 76, 0.8);
  }
  .badge {
    position: absolute;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 500;
    line-height: 1;
  }
  .rating {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.3rem;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .rating svg {
    color: var(--orange);
  }
  .rating strong {
    color: var(--text);
    font-weight: 600;
  }
  .video {
    bottom: 0.65rem;
    left: 0.65rem;
    background: linear-gradient(135deg, #c9a84c, #a8863a);
    color: #fff;
    backdrop-filter: blur(6px);
  }
  .body {
    padding: 0.95rem 0.5rem 0.45rem;
  }
  .city {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brown);
  }
  .name {
    margin-top: 0.3rem;
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.25;
    color: var(--text);
  }
  /* Stukjes naast elkaar met een punt ertussen. Past iets niet meer, dan gaat
     het hele stukje naar de volgende regel; de punt aan het begin van een
     regel valt dan weg (buiten beeld door de negatieve marge). */
  .details-wrap {
    margin-top: 0.3rem;
    overflow: hidden;
  }
  .details {
    display: flex;
    flex-wrap: wrap;
    row-gap: 0.15rem;
    margin-left: -1em;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .details span::before {
    content: '·';
    display: inline-block;
    width: 1em;
    text-align: center;
  }
  .details .vibe,
  .details .price {
    white-space: nowrap;
  }
  /* Mobiel: twee kaartjes naast elkaar, alles iets compacter. */
  @media (max-width: 520px) {
    .card {
      padding: 6px;
      border-radius: 16px;
    }
    .photo {
      border-radius: 11px;
    }
    .badge {
      padding: 0.25rem 0.45rem;
      font-size: 0.68rem;
    }
    .video {
      left: 0.45rem;
      bottom: 0.45rem;
    }
    .rating {
      font-size: 0.8rem;
    }
    .body {
      padding: 0.6rem 0.3rem 0.3rem;
    }
    .city {
      font-size: 0.62rem;
      letter-spacing: 0.1em;
    }
    .name {
      font-size: 1rem;
    }
    .details {
      font-size: 0.8rem;
    }
  }
</style>
