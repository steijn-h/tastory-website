---
import RatingStars from './RatingStars.astro';
import { hasVideo, restaurantPath, type RestaurantListItem } from '../lib/restaurants';
import { normalizeCity, priceLabel, splitUrls } from '../lib/format';

interface Props {
  restaurant: RestaurantListItem;
  showCity?: boolean;
}
const { restaurant: r, showCity = true } = Astro.props;
const photo = splitUrls(r.photo_url)[0] ?? null;
const city = normalizeCity(r.city);
const score = r.weighted_score && r.weighted_score > 0 ? Number(r.weighted_score) : null;
const reviewCount = r.published_review_count ?? 0;
const video = hasVideo(r);
---

<a href={restaurantPath(r)} class="card">
  <div class="photo">
    {
      photo ? (
        <img src={photo} alt={r.name ?? ''} loading="lazy" decoding="async" />
      ) : (
        <div class="placeholder" />
      )
    }
    {
      video && (
        <span class="video-badge">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7z" />
          </svg>
          Video
        </span>
      )
    }
  </div>
  <div class="body">
    <h3 class="name">{r.name}</h3>
    {
      score !== null && (
        <div class="score">
          <RatingStars rating={score} size={13} />
          <span class="score-value">
            {score.toLocaleString('nl-NL', { minimumFractionDigits: 1, maximumFractionDigits: 1 })}
          </span>
          {reviewCount > 0 && <span class="count">({reviewCount})</span>}
        </div>
      )
    }
    <p class="tags">
      {
        [r.cuisine, r.price_level ? priceLabel(r.price_level) : null, showCity ? city : null]
          .filter(Boolean)
          .join(' · ')
      }
    </p>
    <slot />
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border-radius: var(--radius-md);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--beige-dark);
    transition:
      transform 0.2s,
      box-shadow 0.2s;
    height: 100%;
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .card:focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: 2px;
  }
  .photo {
    position: relative;
    aspect-ratio: 4 / 3;
    /* Zonder dit rekt een staande foto het vak op (ongelijke kaartjes). */
    overflow: hidden;
    background: var(--beige-dark);
  }
  .photo img,
  .placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Zelfde idee als de afspeelknop op kaarten in de app. */
  .video-badge {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.55rem 0.25rem 0.45rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: var(--text-xs);
    font-weight: 500;
    backdrop-filter: blur(4px);
  }
  .body {
    padding: 0.85rem 1rem 1rem;
  }
  .name {
    font-family: var(--serif);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.25;
    color: var(--text);
  }
  .score {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.3rem;
    font-size: var(--text-sm);
  }
  .score-value {
    font-weight: 500;
  }
  .count {
    color: var(--text-muted);
  }
  .tags {
    margin-top: 0.3rem;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
</style>
