---
// Opslaan-knop (hartje) met keuze voor een collectie, zoals
// SaveToCollectionSheet in de app. De pagina zelf wordt gecachet, dus of het
// restaurant al is opgeslagen wordt pas in de browser opgehaald. Gasten zonder
// sessie laden geen Supabase-code; die gaan bij een klik naar /inloggen.
import { COLLECTIE_COLORS } from '../lib/account';
import '../styles/app-ui.css';

interface Props {
  restaurantId: string;
  restaurantName: string;
  cuisine?: string | null;
  /** Pad om na het inloggen naar terug te keren. */
  returnPath: string;
}

const { restaurantId, restaurantName, cuisine, returnPath } = Astro.props;
---

<button
  type="button"
  class="save-btn"
  data-save-button
  data-restaurant={restaurantId}
  data-cuisine={cuisine ?? ''}
  data-return={returnPath}
  aria-pressed="false"
>
  <svg
    class="heart"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <path
      d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"
    ></path>
  </svg>
  <span data-save-label>Opslaan</span>
</button>

<dialog class="save-dialog" data-save-dialog aria-labelledby="save-dialog-title">
  <form method="dialog" class="sheet" data-save-form>
    <header class="sheet-head">
      <h2 id="save-dialog-title">Opslaan</h2>
      <p class="ui-muted">{restaurantName}</p>
    </header>

    <p class="ui-error" data-save-error role="alert"></p>

    <div class="ui-field">
      <label class="ui-label" for="save-note"
        >Notitie <span class="ui-muted">(optioneel)</span></label
      >
      <textarea
        class="ui-input note"
        id="save-note"
        data-save-note
        maxlength="300"
        rows="2"
        placeholder="Bijv. voor verjaardag van mama"></textarea>
    </div>

    <p class="ui-label list-title">Kies een collectie</p>
    <ul class="collections" data-collection-list>
      <li>
        <button type="button" class="collection" data-collectie="">
          <span class="dot dot-general" aria-hidden="true"></span>
          <span>Algemeen</span>
        </button>
      </li>
    </ul>
    <p class="ui-muted loading" data-collection-loading>Collecties laden…</p>

    <button type="button" class="ui-btn-link new-toggle" data-new-toggle>+ Nieuwe collectie</button>
    <div class="new-collection" data-new-collection hidden>
      <div class="ui-field">
        <label class="ui-label" for="new-collection-name">Naam van de collectie</label>
        <input
          class="ui-input"
          id="new-collection-name"
          data-new-name
          type="text"
          maxlength="40"
          placeholder="Bijv. Date night"
        />
      </div>
      <div class="colors" role="radiogroup" aria-label="Kleur">
        {
          COLLECTIE_COLORS.map((color, i) => (
            <button
              type="button"
              class="swatch"
              role="radio"
              aria-checked={i === 0 ? 'true' : 'false'}
              aria-label={`Kleur ${i + 1}`}
              data-color={color}
              style={`--swatch:${color}`}
            />
          ))
        }
      </div>
      <button type="button" class="ui-btn ui-btn-primary ui-btn-block" data-new-submit
        >Aanmaken en opslaan</button
      >
    </div>

    <button type="submit" class="ui-btn ui-btn-ghost ui-btn-block cancel" value="cancel"
      >Annuleren</button
    >
  </form>
</dialog>

<div class="toast" data-save-toast role="status" aria-live="polite"></div>

<script>
  import { AUTH_COOKIE_NAME } from '../lib/auth-cookie';

  type Account = typeof import('../lib/account');
  type SupabaseClient = import('@supabase/supabase-js').SupabaseClient;

  const button = document.querySelector<HTMLButtonElement>('[data-save-button]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-save-dialog]');

  if (button && dialog) {
    const restaurantId = button.dataset.restaurant ?? '';
    const cuisine = button.dataset.cuisine ?? '';
    const returnPath = button.dataset.return ?? location.pathname;
    const label = button.querySelector<HTMLElement>('[data-save-label]')!;
    const errorEl = dialog.querySelector<HTMLElement>('[data-save-error]')!;
    const noteEl = dialog.querySelector<HTMLTextAreaElement>('[data-save-note]')!;
    const list = dialog.querySelector<HTMLUListElement>('[data-collection-list]')!;
    const loadingEl = dialog.querySelector<HTMLElement>('[data-collection-loading]')!;
    const newToggle = dialog.querySelector<HTMLButtonElement>('[data-new-toggle]')!;
    const newBox = dialog.querySelector<HTMLElement>('[data-new-collection]')!;
    const newName = dialog.querySelector<HTMLInputElement>('[data-new-name]')!;
    const newSubmit = dialog.querySelector<HTMLButtonElement>('[data-new-submit]')!;
    const toast = document.querySelector<HTMLElement>('[data-save-toast]')!;

    let saved = false;
    let busy = false;
    let selectedColor = dialog.querySelector<HTMLElement>('.swatch')?.dataset.color ?? '#E8612A';
    let ctx: { supabase: SupabaseClient; account: Account; userId: string } | null = null;

    const hasCookie = () =>
      document.cookie.split(';').some((c) => c.trim().startsWith(AUTH_COOKIE_NAME));

    // Supabase-code alleen laden als er een sessie is (of bij het opslaan).
    async function getContext() {
      if (ctx) return ctx;
      if (!hasCookie()) return null;
      const [{ getBrowserSupabase }, account] = await Promise.all([
        import('../lib/supabase-browser'),
        import('../lib/account'),
      ]);
      const supabase = getBrowserSupabase();
      const { data } = await supabase.auth.getSession();
      const userId = data.session?.user.id;
      if (!userId) return null;
      ctx = { supabase, account, userId };
      return ctx;
    }

    function setSaved(value: boolean) {
      saved = value;
      button!.classList.toggle('is-saved', value);
      button!.setAttribute('aria-pressed', String(value));
      label.textContent = value ? 'Opgeslagen' : 'Opslaan';
    }

    let toastTimer: ReturnType<typeof setTimeout> | undefined;
    function showToast(message: string) {
      toast.textContent = message;
      toast.classList.add('visible');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.remove('visible'), 2600);
    }

    function goToLogin() {
      location.href = `/inloggen?next=${encodeURIComponent(returnPath)}`;
    }

    async function save(collectieId: string | null, collectieName: string) {
      const c = await getContext();
      if (!c || busy) return;
      busy = true;
      errorEl.textContent = '';
      try {
        await c.account.saveRestaurant(c.supabase, c.userId, restaurantId, {
          cuisine,
          collectieId,
          note: noteEl.value,
        });
        setSaved(true);
        dialog!.close();
        showToast(`Opgeslagen in ${collectieName}`);
      } catch (e) {
        errorEl.textContent = (e as Error).message;
      } finally {
        busy = false;
      }
    }

    function renderCollections(items: { id: string; naam: string | null; kleur: string | null }[]) {
      list.querySelectorAll('[data-dynamic]').forEach((el) => el.remove());
      for (const item of items) {
        const li = document.createElement('li');
        li.dataset.dynamic = 'true';
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'collection';
        btn.dataset.collectie = item.id;
        const dot = document.createElement('span');
        dot.className = 'dot';
        dot.style.background = item.kleur || '#E8612A';
        const name = document.createElement('span');
        name.textContent = item.naam || 'Collectie';
        btn.append(dot, name);
        li.append(btn);
        list.append(li);
      }
    }

    async function openDialog() {
      const c = await getContext();
      if (!c) return goToLogin();
      errorEl.textContent = '';
      newBox.hidden = true;
      newToggle.hidden = false;
      newName.value = '';
      loadingEl.hidden = false;
      dialog!.showModal();
      try {
        renderCollections(await c.account.listCollecties(c.supabase, c.userId));
      } catch (e) {
        errorEl.textContent = (e as Error).message;
      } finally {
        loadingEl.hidden = true;
      }
    }

    button.addEventListener('click', async () => {
      if (busy) return;
      const c = await getContext();
      if (!c) return goToLogin();
      if (!saved) return openDialog();
      // Al opgeslagen: verwijderen, zoals de app (ook uit collecties).
      busy = true;
      setSaved(false);
      try {
        await c.account.removeSavedRestaurant(c.supabase, c.userId, restaurantId);
        showToast('Verwijderd uit opgeslagen');
      } catch (e) {
        setSaved(true);
        showToast((e as Error).message);
      } finally {
        busy = false;
      }
    });

    list.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-collectie]');
      if (!target) return;
      const id = target.dataset.collectie || null;
      void save(id, id ? `"${target.textContent?.trim()}"` : 'Algemeen');
    });

    newToggle.addEventListener('click', () => {
      newBox.hidden = false;
      newToggle.hidden = true;
      newName.focus();
    });

    dialog.querySelectorAll<HTMLButtonElement>('.swatch').forEach((swatch) => {
      swatch.addEventListener('click', () => {
        selectedColor = swatch.dataset.color ?? selectedColor;
        dialog!
          .querySelectorAll('.swatch')
          .forEach((s) => s.setAttribute('aria-checked', String(s === swatch)));
      });
    });

    newSubmit.addEventListener('click', async () => {
      const name = newName.value.trim();
      if (!name) {
        errorEl.textContent = 'Geef je collectie een naam.';
        newName.focus();
        return;
      }
      const c = await getContext();
      if (!c) return goToLogin();
      newSubmit.disabled = true;
      try {
        const created = await c.account.createCollectie(c.supabase, c.userId, name, selectedColor);
        await save(created.id, `"${created.naam ?? name}"`);
      } catch (e) {
        errorEl.textContent = (e as Error).message;
      } finally {
        newSubmit.disabled = false;
      }
    });

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    // Huidige status ophalen (alleen met sessie).
    void getContext().then(async (c) => {
      if (!c) return;
      setSaved(await c.account.isRestaurantSaved(c.supabase, c.userId, restaurantId));
    });
  }
</script>

<style>
  .save-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    font-family: var(--sans);
    font-weight: 500;
    font-size: var(--text-sm);
    padding: 0.7rem 1.2rem;
    border-radius: var(--radius-sm);
    background: var(--white);
    color: var(--text);
    border: 1px solid var(--beige-deeper);
    cursor: pointer;
    white-space: nowrap;
    transition: border-color 0.2s;
  }
  .save-btn:hover {
    border-color: var(--brown);
  }
  .save-btn:focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: 2px;
  }
  .heart {
    fill: none;
    transition:
      fill 0.2s,
      color 0.2s;
  }
  .save-btn.is-saved .heart {
    fill: var(--orange);
    color: var(--orange);
  }

  .save-dialog {
    border: none;
    padding: 0;
    background: transparent;
    width: min(440px, calc(100vw - 2rem));
    max-height: calc(100vh - 2rem);
    margin: auto;
  }
  .save-dialog::backdrop {
    background: rgba(58, 46, 34, 0.45);
  }
  .sheet {
    background: var(--white);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    box-shadow: var(--shadow-xl);
  }
  .sheet-head {
    margin-bottom: var(--space-md);
  }
  .sheet-head h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: var(--text-2xl);
    color: var(--text);
  }
  .note {
    min-height: 3.5rem;
  }
  .list-title {
    margin-bottom: var(--space-sm);
  }
  .collections {
    list-style: none;
    display: grid;
    gap: 0.4rem;
    max-height: 15rem;
    overflow-y: auto;
  }
  .collections :global(.collection) {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: 100%;
    padding: 0.7rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--beige-deeper);
    background: #fff;
    font: inherit;
    font-size: var(--text-base);
    color: var(--text);
    text-align: left;
    cursor: pointer;
  }
  .collections :global(.collection:hover) {
    border-color: var(--brown);
  }
  .collections :global(.dot) {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .dot-general {
    background: var(--brown);
  }
  .loading {
    font-size: var(--text-sm);
    margin-top: var(--space-sm);
  }
  .new-toggle {
    margin: var(--space-md) 0;
  }
  .new-collection {
    margin: var(--space-md) 0;
  }
  .colors {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--space-md);
  }
  .swatch {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--swatch);
    border: 3px solid transparent;
    cursor: pointer;
  }
  .swatch[aria-checked='true'] {
    border-color: var(--white);
    box-shadow: 0 0 0 2px var(--text);
  }
  .cancel {
    margin-top: var(--space-sm);
  }

  /* Bovenin, onder de navigatie: onderin zit op mobiel de vaste actiebalk. */
  .toast {
    position: fixed;
    left: 50%;
    top: 96px;
    transform: translate(-50%, -0.5rem);
    max-width: calc(100vw - 2rem);
    text-align: center;
    background: var(--text);
    color: #fff;
    padding: 0.7rem 1.1rem;
    border-radius: 999px;
    font-size: var(--text-sm);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.2s,
      transform 0.2s;
    z-index: 200;
  }
  .toast:global(.visible) {
    opacity: 1;
    transform: translate(-50%, 0);
  }
</style>
