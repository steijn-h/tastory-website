---
// Terug-pijl bovenaan een pagina. Kom je van een andere pagina op Tastory,
// dan gaat hij echt terug (zoekopdracht, filters en scrollpositie blijven
// bewaard). Kom je van buiten (bijv. Google), dan naar de bovenliggende pagina.
interface Props {
  /** Bovenliggende pagina, bijv. /restaurants. */
  href: string;
  /** Tekst als er geen vorige Tastory-pagina is, bijv. "Alle restaurants". */
  label: string;
}
const { href, label } = Astro.props;
---

<a class="back" href={href} data-back-link>
  <span class="arrow" aria-hidden="true">
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M15 18l-6-6 6-6"></path>
    </svg>
  </span>
  <span data-back-label>{label}</span>
</a>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-back-link]').forEach((link) => {
    let fromTastory = false;
    try {
      fromTastory =
        Boolean(document.referrer) && new URL(document.referrer).origin === location.origin;
    } catch {
      fromTastory = false;
    }
    if (!fromTastory || history.length < 2) return;
    const label = link.querySelector('[data-back-label]');
    if (label) label.textContent = 'Terug';
    link.addEventListener('click', (e) => {
      e.preventDefault();
      history.back();
    });
  });
</script>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: var(--space-sm);
    padding: 0.3rem 0.85rem 0.3rem 0.3rem;
    border-radius: 999px;
    background: var(--white);
    border: 1px solid var(--beige-deeper);
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .back:hover {
    border-color: var(--brown);
  }
  .back:focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: 2px;
  }
  .arrow {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--beige);
    color: var(--brown-dark);
  }
</style>
