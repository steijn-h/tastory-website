---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout
  title="Download de app — Tastory"
  description="De Tastory app is nu live! Download hem gratis in de App Store en ontdek restaurants die écht bij jou passen."
>
  <script is:inline>
    (function () {
      var ua = navigator.userAgent || navigator.vendor || '';
      var iosUrl = 'https://apps.apple.com/nl/app/tastory/id6762256086';
      var androidUrl = 'https://play.google.com/store/apps/details?id=nl.tastory.app';

      if (/android/i.test(ua)) {
        window.location.replace(androidUrl);
      } else if (/iPad|iPhone|iPod/.test(ua) && !window.MSStream) {
        window.location.replace(iosUrl);
      }
    })();
  </script>

  <PageHero
    title="De app is <em>live!</em>"
    description="Download Tastory gratis in de App Store en ontdek restaurants die écht bij jou passen."
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Tastory',
      url: 'https://www.tastory.nl/download',
      downloadUrl: 'https://apps.apple.com/nl/app/tastory/id6762256086',
      screenshot: 'https://www.tastory.nl/tastory-logo.png',
      softwareVersion: '1.0',
      operatingSystem: 'iOS, Android',
      applicationCategory: 'LifestyleApplication',
      description:
        'Download de Tastory app en ontdek restaurants die écht bij jou passen op basis van sfeer, keuken en stijl.',
      inLanguage: 'nl-NL',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'EUR',
      },
      publisher: {
        '@type': 'Organization',
        name: 'Tastory',
        url: 'https://www.tastory.nl',
      },
    })}
  />
  <section class="signup-section">
    <div class="signup-grid">
      <div class="signup-card reveal">
        <div class="card-tag">Voor Foodies</div>
        <h2>Download <em>Tastory</em></h2>
        <p>
          Ontdek restaurants die écht bij jou passen op basis van sfeer, keuken en stijl. De app is
          nu gratis beschikbaar in de App Store en Google Play.
        </p>
        <div class="store-badges">
          <a
            href="https://apps.apple.com/nl/app/tastory/id6762256086"
            target="_blank"
            rel="noopener noreferrer"
            class="app-store-btn"
          >
            <img
              src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg"
              alt="Download on the App Store"
              width="156"
              height="52"
            />
          </a>
          <a
            href="https://play.google.com/store/apps/details?id=nl.tastory.app&pli=1"
            target="_blank"
            rel="noopener noreferrer"
            class="app-store-btn google-play-btn"
          >
            <img
              src="https://play.google.com/intl/en_us/badges/static/images/badges/en_badge_web_generic.png"
              alt="Get it on Google Play"
              width="200"
              height="77"
            />
          </a>
        </div>
        <div class="card-note">Gratis te downloaden. Beschikbaar op iOS &amp; Android.</div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .signup-section {
    padding: 5rem 3rem 7rem;
    max-width: 100%;
  }

  .signup-grid {
    display: grid;
    grid-template-columns: 1fr;
    max-width: 550px;
    margin: 0 auto;
  }

  .signup-card {
    background: var(--white);
    border: 1px solid rgba(136, 101, 69, 0.1);
    border-radius: var(--radius-lg);
    padding: 3rem;
    box-shadow: var(--shadow-md);
  }

  .card-tag {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--orange);
    background: rgba(255, 142, 62, 0.1);
    padding: 0.35rem 0.9rem;
    border-radius: 100px;
    margin-bottom: 1.25rem;
  }

  .signup-card h2 {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    color: var(--text);
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .signup-card h2 em {
    color: var(--orange);
    font-style: normal;
  }

  .signup-card > p {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.75;
    margin-bottom: 2rem;
  }

  .card-note {
    font-size: 0.85rem;
    color: var(--text-muted);
    opacity: 0.6;
    margin-top: 0.75rem;
  }

  .store-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .app-store-btn {
    display: inline-block;
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
    transition: opacity 0.2s;
  }

  .app-store-btn img {
    height: 52px;
    width: auto;
  }

  .app-store-btn:hover {
    opacity: 0.85;
  }

  /* Google's official badge has ~40px of baked-in transparent padding around
     the button, while Apple's does not — crop it so both badges read at the
     same visual height. */
  .google-play-btn {
    height: 52px;
    overflow: hidden;
  }

  .google-play-btn img {
    height: 77px;
    margin: -13px 0 0 -13px;
  }

  @media (max-width: 768px) {
    .signup-section {
      padding: 4rem 1.5rem 5rem;
    }

    .signup-grid {
      grid-template-columns: 1fr;
    }

    .signup-card {
      padding: 2rem;
    }
  }
</style>
