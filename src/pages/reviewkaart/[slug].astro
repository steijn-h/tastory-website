---
// Printbare reviewkaartjes voor op tafel of bij de rekening: 4 kaartjes (A6)
// op een A4, met een QR-code naar de reviewpagina van het restaurant. Losse
// pagina zonder menu en footer, zodat afdrukken of opslaan als PDF meteen goed
// gaat.
export const prerender = false;

import QRCode from 'qrcode';
import { getRestaurant, isUuid, restaurantPath } from '../../lib/restaurants';
import { SITE_URL } from '../../lib/links';

const param = Astro.params.slug ?? '';
const lookup = await getRestaurant(param);
if (lookup.status === 'not-found') {
  return new Response(null, { status: 404 });
}
if (lookup.status === 'error') {
  return new Response('Probeer het over een paar minuten opnieuw.', {
    status: 503,
    headers: { 'Retry-After': '120' },
  });
}
const restaurant = lookup.restaurant;
if (isUuid(param) && restaurant.slug) {
  return Astro.redirect(`/reviewkaart/${restaurant.slug}`, 301);
}
Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const name = restaurant.name ?? 'dit restaurant';
const reviewUrl = `${SITE_URL}${restaurantPath(restaurant)}/review`;
const qrSvg = await QRCode.toString(reviewUrl, {
  type: 'svg',
  margin: 0,
  errorCorrectionLevel: 'M',
  color: { dark: '#3a2e22', light: '#ffffff' },
});
const cards = [0, 1, 2, 3];
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Reviewkaartjes {name} | Tastory</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600&family=Roboto:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="toolbar">
      <div class="toolbar-inner">
        <div>
          <h1>Reviewkaartjes voor {name}</h1>
          <p>
            Vier kaartjes op één A4. Print ze, knip ze los en leg ze op tafel of bij de rekening.
            Gasten scannen de QR-code en schrijven direct een review op Tastory.
          </p>
        </div>
        <div class="toolbar-actions">
          <button type="button" class="btn btn-primary" id="print"
            >Afdrukken of opslaan als PDF</button
          >
          <a class="btn btn-ghost" href={`/badge?r=${encodeURIComponent(restaurant.slug ?? '')}`}
            >Ook de badge voor je website →</a
          >
        </div>
      </div>
    </header>

    <div class="sheet-wrap">
      <main class="sheet" aria-label="A4 met vier reviewkaartjes">
        {
          cards.map(() => (
            <section class="card">
              <img class="logo" src="/tastory-logo.png" alt="Tastory" width="711" height="400" />
              <p class="kicker">Hoe was het bij</p>
              <h2 class="name">{name}?</h2>
              <div class="qr" set:html={qrSvg} />
              <p class="cta">Scan en laat je review achter</p>
              <p class="note">Met je camera, het duurt maar een minuutje.</p>
              <p class="foot">tastory.nl</p>
            </section>
          ))
        }
      </main>
    </div>

    <script>
      document.getElementById('print')?.addEventListener('click', () => window.print());
    </script>

    <style is:global>
      @page {
        size: A4;
        margin: 0;
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: 'Roboto', sans-serif;
        color: #3a2e22;
        background: #f5ebdd;
      }
      .toolbar {
        background: #fffcf8;
        border-bottom: 1px solid #ddd1c0;
        padding: 20px 16px;
      }
      .toolbar-inner {
        max-width: 210mm;
        margin: 0 auto;
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        align-items: center;
        justify-content: space-between;
      }
      .toolbar h1 {
        font-family: 'Fredoka', sans-serif;
        font-weight: 500;
        font-size: 1.4rem;
        margin-bottom: 4px;
      }
      .toolbar p {
        color: #8a7a6a;
        font-size: 0.9rem;
        max-width: 60ch;
        line-height: 1.5;
      }
      .toolbar-actions {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      .btn {
        display: inline-flex;
        justify-content: center;
        padding: 0.7rem 1.2rem;
        border-radius: 999px;
        font:
          500 0.9rem 'Roboto',
          sans-serif;
        text-decoration: none;
        cursor: pointer;
        border: 1px solid transparent;
      }
      .btn-primary {
        background: #ff8e3e;
        color: #fff;
      }
      .btn-primary:hover {
        background: #e67a2e;
      }
      .btn-ghost {
        background: transparent;
        border-color: #ddd1c0;
        color: #3a2e22;
      }
      .sheet-wrap {
        padding: 24px 16px 48px;
        overflow-x: auto;
      }
      .sheet {
        width: 210mm;
        height: 297mm;
        margin: 0 auto;
        background: #fff;
        box-shadow: 0 8px 30px rgba(136, 101, 69, 0.12);
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 1fr 1fr;
      }
      /* Stippellijnen om langs te knippen. */
      .card {
        border: 0.3mm dashed #ddd1c0;
        margin: -0.15mm;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 10mm 8mm;
        background: #fffcf8;
      }
      .logo {
        width: 34mm;
        height: auto;
        margin-bottom: 7mm;
      }
      .kicker {
        font-size: 10pt;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #8a7a6a;
      }
      .name {
        font-family: 'Fredoka', sans-serif;
        font-weight: 600;
        font-size: 18pt;
        line-height: 1.15;
        margin: 1.5mm 0 6mm;
        overflow-wrap: anywhere;
      }
      .qr {
        width: 46mm;
        height: 46mm;
        padding: 3mm;
        background: #fff;
        border-radius: 3mm;
        border: 0.3mm solid #ddd1c0;
      }
      .qr svg {
        display: block;
        width: 100%;
        height: 100%;
      }
      .cta {
        margin-top: 6mm;
        font-weight: 500;
        font-size: 11.5pt;
        color: #e67a2e;
      }
      .note {
        margin-top: 1mm;
        font-size: 9pt;
        color: #8a7a6a;
      }
      .foot {
        margin-top: 5mm;
        font-size: 8.5pt;
        color: #8a7a6a;
        letter-spacing: 0.04em;
      }
      @media print {
        body {
          background: #fff;
        }
        .toolbar {
          display: none;
        }
        .sheet-wrap {
          padding: 0;
          overflow: visible;
        }
        /* Net iets minder dan 297mm, anders maakt afronding er 2 pagina's van. */
        .sheet {
          box-shadow: none;
          margin: 0;
          height: 296mm;
          overflow: hidden;
        }
      }
    </style>
  </body>
</html>
