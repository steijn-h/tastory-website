  .map-consent {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    padding: var(--space-md);
    border: none;
    cursor: pointer;
    color: var(--brown);
    font-family: var(--sans);
    text-align: center;
    /* Licht stratenpatroon als achtergrond, zonder externe kaart. */
