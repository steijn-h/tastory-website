      linear-gradient(90deg, transparent 47%, rgba(255, 255, 255, 0.7) 47%, rgba(255, 255, 255, 0.7) 53%, transparent 53%) 0 0 / 90px 90px,
      linear-gradient(0deg, transparent 47%, rgba(255, 255, 255, 0.7) 47%, rgba(255, 255, 255, 0.7) 53%, transparent 53%) 0 0 / 70px 70px,
      linear-gradient(30deg, transparent 49%, rgba(255, 255, 255, 0.55) 49%, rgba(255, 255, 255, 0.55) 51%, transparent 51%) 0 0 / 160px 160px,
      var(--beige-dark);
  }
  .map-consent svg {
    color: var(--orange);
    filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.15));
