---
// Openbare restaurantpagina (zoals TripAdvisor): voor iedereen zichtbaar, ook
// zonder account. Toont dezelfde gegevens als de restaurantpagina in de app.
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import RatingStars from '../../components/RatingStars.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import RestaurantCard from '../../components/RestaurantCard.astro';
import SaveButton from '../../components/SaveButton.astro';
import BackLink from '../../components/BackLink.astro';
import {
  cityPath,
  getAllRestaurants,
  getRestaurant,
  getReviews,
  getReviewStats,
  getStories,
  isPartnerRestaurant,
  isUuid,
  restaurantPath,
  type Restaurant,
} from '../../lib/restaurants';
import {
  capitalize,
  displayWebsite,
  formatReviewDate,
  isImageUrl,
  normalizeCity,
  normalizeWebsite,
  parseOpeningHours,
  priceLabel,
  safeHttpsUrl,
  splitUrls,
  todayDutch,
} from '../../lib/format';
import { APP_STORE_URL, SITE_URL } from '../../lib/links';
import { describeRestaurant, describeRestaurantShort } from '../../lib/restaurant-text';
import { imageSrcset, imageUrl } from '../../lib/image';

const param = Astro.params.slug ?? '';
const lookup = await getRestaurant(param);

// Oude deellinks uit de app gebruiken het id — stuur door naar de nette URL.
if (lookup.status === 'ok' && isUuid(param) && lookup.restaurant.slug) {
  return Astro.redirect(`/restaurant/${lookup.restaurant.slug}`, 301);
}

const restaurant: Restaurant | null = lookup.status === 'ok' ? lookup.restaurant : null;

const [reviewPage, stats, stories, allRestaurants] = restaurant
  ? await Promise.all([
      getReviews(restaurant.id),
      getReviewStats(restaurant.id),
      getStories(restaurant.id),
      getAllRestaurants(),
    ])
  : [null, null, [], null];

if (lookup.status === 'not-found') {
  Astro.response.status = 404;
} else if (lookup.status === 'error') {
  // Tijdelijke fout: 503 zodat Google de pagina niet uit de index haalt.
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '120');
} else {
  // Vercel bewaart de pagina 5 minuten aan de rand van het netwerk.
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400');
}

// ── Afgeleide gegevens ─────────────────────────────────────────────────────
const name = restaurant?.name ?? 'Restaurant';
const city = normalizeCity(restaurant?.city);
const photos = splitUrls(restaurant?.photo_url);
const isPartner = restaurant ? isPartnerRestaurant(restaurant) : false;
const videoUrl = safeHttpsUrl(restaurant?.video_url);
const backgroundUrl = safeHttpsUrl(restaurant?.background_url);
const score =
  restaurant?.weighted_score && restaurant.weighted_score > 0 ? Number(restaurant.weighted_score) : null;
const reviewCount = stats?.count ?? restaurant?.published_review_count ?? 0;
const reviews = reviewPage?.reviews ?? [];
const hours = parseOpeningHours(restaurant?.opening_hours);
const today = todayDutch();
const website = normalizeWebsite(restaurant?.website);
const reserveUrl = safeHttpsUrl(restaurant?.Reserveer_url) ?? safeHttpsUrl(restaurant?.reservering_url);
const menuUrls = splitUrls(restaurant?.menukaart_url);
const menuImages = menuUrls.filter(isImageUrl);
const menuLink = menuUrls.find((u) => !isImageUrl(u)) ?? null;
const instagram = safeHttpsUrl(restaurant?.instagram_url);
const facebook = safeHttpsUrl(restaurant?.facebook_url);
const facilities = (restaurant?.facilities ?? []).filter(Boolean).map(capitalize);
const allergies = (restaurant?.allergie_keuze ?? []).filter(Boolean).map(capitalize);
const phone = restaurant?.phone?.trim() || null;
const phoneHref = phone ? `tel:${phone.replace(/[^\d+]/g, '')}` : null;
const hasCoords =
  typeof restaurant?.lat === 'number' && typeof restaurant?.lng === 'number' && restaurant.lat !== 0;
const routeUrl = restaurant
  ? hasCoords
    ? `https://www.google.com/maps/dir/?api=1&destination=${restaurant.lat},${restaurant.lng}`
    : restaurant.address
      ? `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${restaurant.address} ${restaurant.city ?? ''}`)}`
      : null
  : null;
// Google Maps zoekt op naam + adres, zodat het restaurant zelf als pin met
// naam verschijnt (anders op coördinaten).
const mapQuery = restaurant
  ? restaurant.address
    ? `${name}, ${restaurant.address}${city && !restaurant.address.toLowerCase().includes(city.toLowerCase()) ? `, ${city}` : ''}`
    : hasCoords
      ? `${restaurant.lat},${restaurant.lng}`
      : null
  : null;
const mapEmbedUrl = mapQuery
  ? `https://maps.google.com/maps?q=${encodeURIComponent(mapQuery)}&z=16&hl=nl&output=embed`
  : null;
const deepLinkUrl = restaurant ? `tastory://restaurant/${restaurant.id}` : 'tastory://';
const nearby = (allRestaurants ?? [])
  .filter((r) => restaurant && r.id !== restaurant.id && city && normalizeCity(r.city) === city)
  .slice(0, 4);
// Mozaïek: hoofdbeeld + 0, 2 of 4 kleine foto's (nooit een leeg vak).
const thumbPool = videoUrl ? photos : photos.slice(1);
const thumbs = thumbPool.slice(0, thumbPool.length >= 4 ? 4 : thumbPool.length >= 2 ? 2 : 0);
const thumbOffset = videoUrl ? 0 : 1;
const maxDistribution = stats ? Math.max(1, ...stats.distribution) : 1;
const formatScore = (value: number) =>
  value.toLocaleString('nl-NL', { minimumFractionDigits: 1, maximumFractionDigits: 1 });

// ── SEO ────────────────────────────────────────────────────────────────────
const canonicalPath = restaurant ? restaurantPath(restaurant) : `/restaurant/${param}`;
const title = restaurant
  ? `${name}${city ? `, ${city}` : ''} — reviews, foto's & menu | Tastory`
  : 'Restaurant niet gevonden | Tastory';
// Eigen, feitelijke samenvatting: de beschrijving komt vaak letterlijk van de
// site van het restaurant (dubbele content voor Google). Deze zin is per
// pagina uniek en makkelijk te citeren door zoekmachines en AI-assistenten.
const textInput = restaurant
  ? {
      name,
      city,
      address: restaurant.address,
      cuisine: restaurant.cuisine,
      vibe: restaurant.vibe,
      priceLevel: restaurant.price_level,
      score,
      reviewCount,
    }
  : null;
const summary = textInput ? describeRestaurant(textInput) : '';
const metaLead = textInput
  ? `${describeRestaurantShort(textInput)}${
      score !== null && reviewCount > 0
        ? ` ${formatScore(score)}/5 uit ${reviewCount === 1 ? '1 review' : `${reviewCount} reviews`}.`
        : ''
    } Bekijk foto's, menu en openingstijden op Tastory.`
  : '';
const description = restaurant ? metaLead : 'Dit restaurant staat niet (meer) op Tastory.';
const keywords = restaurant
  ? [name, city, restaurant.cuisine, restaurant.vibe, city ? `restaurant ${city}` : null, 'reviews', 'Tastory'].filter(
      (k): k is string => Boolean(k),
    )
  : [];

const jsonLd = restaurant
  ? {
      '@context': 'https://schema.org',
      '@type': 'Restaurant',
      '@id': `${SITE_URL}${canonicalPath}#restaurant`,
      name,
      url: `${SITE_URL}${canonicalPath}`,
      description: restaurant.description?.trim() || summary || undefined,
      image: photos.length > 0 ? photos.slice(0, 6) : undefined,
      servesCuisine: restaurant.cuisine ?? undefined,
      priceRange: restaurant.price_level ? priceLabel(restaurant.price_level) : undefined,
      telephone: phone ?? undefined,
      menu: menuLink ?? undefined,
      acceptsReservations: reserveUrl ? 'True' : undefined,
      sameAs: [website, instagram, facebook].filter(Boolean),
      address: restaurant.address
        ? {
            '@type': 'PostalAddress',
            streetAddress: restaurant.address,
            addressLocality: city ?? undefined,
            addressCountry: 'NL',
          }
        : undefined,
      geo: hasCoords ? { '@type': 'GeoCoordinates', latitude: restaurant.lat, longitude: restaurant.lng } : undefined,
      aggregateRating:
        score !== null && reviewCount > 0
          ? {
              '@type': 'AggregateRating',
              ratingValue: score.toFixed(1),
              bestRating: '5',
              worstRating: '1',
              reviewCount: String(reviewCount),
            }
          : undefined,
      review: reviews
        .filter((r) => r.rating)
        .slice(0, 5)
        .map((r) => ({
          '@type': 'Review',
          author: { '@type': 'Person', name: r.author.name },
          datePublished: r.created_at?.slice(0, 10),
          reviewBody: r.text ?? undefined,
          reviewRating: { '@type': 'Rating', ratingValue: String(r.rating), bestRating: '5', worstRating: '1' },
        })),
    }
  : null;

// Video-gegevens voor Google (kan een video-resultaat opleveren). Google eist
// een uploaddatum en een miniatuur; de uploaddatum van de video zelf staat
// niet in de database, dus we gebruiken de datum waarop het restaurant op
// Tastory kwam.
const videoLd =
  restaurant && videoUrl && photos[0] && restaurant.created_at
    ? {
        '@context': 'https://schema.org',
        '@type': 'VideoObject',
        name: `Video van ${name}${city ? ` in ${city}` : ''}`,
        description: summary || `Video van ${name} op Tastory.`,
        thumbnailUrl: [photos[0]],
        uploadDate: restaurant.created_at,
        contentUrl: videoUrl,
        publisher: { '@type': 'Organization', name: 'Tastory', url: SITE_URL },
      }
    : null;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Restaurants', path: '/restaurants' },
  ...(city ? [{ name: city, path: cityPath(city) }] : []),
  ...(restaurant ? [{ name, path: canonicalPath }] : []),
];
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: `${SITE_URL}${b.path}`,
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  ogImage={restaurant?.slug && photos[0] ? `${SITE_URL}/og/restaurant/${restaurant.slug}.jpg` : undefined}
  ogImageIsWide={Boolean(restaurant?.slug && photos[0])}
  noindex={!restaurant}
>
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  {restaurant && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
  {videoLd && <script type="application/ld+json" set:html={JSON.stringify(videoLd)} />}

  {!restaurant ? (
    <div class="page">
      <div class="container narrow">
        <div class="state-card">
          {lookup.status === 'not-found' ? (
            <>
              <h1>Restaurant niet gevonden</h1>
              <p>Dit restaurant staat niet (meer) op Tastory, of de link is niet helemaal goed.</p>
            </>
          ) : (
            <>
              <h1>Even geduld</h1>
              <p>We kunnen dit restaurant op dit moment niet laden. Probeer het over een paar minuten opnieuw.</p>
            </>
          )}
          <a class="btn btn-primary" href="/restaurants">Bekijk alle restaurants</a>
        </div>
      </div>
    </div>
  ) : (
    <div class:list={['page', { partner: isPartner && backgroundUrl }]} style={isPartner && backgroundUrl ? `--partner-bg: url('${backgroundUrl}')` : undefined} data-restaurant-id={restaurant.id} data-restaurant-cuisine={restaurant.cuisine ?? ''}>
      <div class="container">
        <BackLink
          href={city ? cityPath(city) : '/restaurants'}
          label={city ? `Restaurants in ${city}` : 'Alle restaurants'}
        />
        <nav class="breadcrumbs" aria-label="Kruimelpad">
          <ol>
            {breadcrumbs.map((b, i) => (
              <li>
                {i < breadcrumbs.length - 1 ? <a href={b.path}>{b.name}</a> : <span aria-current="page">{b.name}</span>}
              </li>
            ))}
          </ol>
        </nav>

        <!-- Kop -->
        <header class="head">
          <div class="head-main">
            <h1 class="name">{name}</h1>
            <div class="head-meta">
              {score !== null && (
                <a href="#reviews" class="head-score">
                  <RatingStars rating={score} size={18} />
                  <strong>{formatScore(score)}</strong>
                  <span class="muted">{reviewCount === 1 ? '1 review' : `${reviewCount} reviews`}</span>
                </a>
              )}
              {[restaurant.cuisine, restaurant.vibe, restaurant.price_level ? priceLabel(restaurant.price_level) : null]
                .filter(Boolean)
                .map((tag) => <span class="tag">{tag}</span>)}
              {isPartner && <span class="tag tag-partner">Tastory partner</span>}
            </div>
          </div>
          <div class="head-actions">
            <SaveButton
              restaurantId={restaurant.id}
              restaurantName={name}
              cuisine={restaurant.cuisine}
              returnPath={canonicalPath}
            />
            <button type="button" class="btn btn-ghost" id="share-btn" data-track="share_restaurant" data-title={name} data-url={`${SITE_URL}${canonicalPath}`}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" /><path d="m16 6-4-4-4 4" /><path d="M12 2v13" /></svg>
              <span id="share-label">Delen</span>
            </button>
            {reserveUrl && (
              <a class="btn btn-primary" href={reserveUrl} data-track="make_reservation" target="_blank" rel="noopener noreferrer">Reserveer</a>
            )}
          </div>
        </header>

        <!-- Foto's / video -->
        {(videoUrl || photos.length > 0) && (
          <section class:list={['media', `thumbs-${thumbs.length}`]} aria-label="Foto's">
            {videoUrl ? (
              <div class="media-main video-wrap" data-video-wrap>
                <video src={videoUrl} poster={photos[0] ? imageUrl(photos[0], 1280) : undefined} autoplay muted loop playsinline preload="metadata" class="media-img video" aria-label={`Video van ${name}, klik voor volledig scherm`} />
                <div class="video-controls">
                  <button type="button" class="video-btn" data-video-sound aria-label="Geluid aan" aria-pressed="false">
                    <svg class="icon-muted" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5z" /><line x1="22" y1="9" x2="16" y2="15" /><line x1="16" y1="9" x2="22" y2="15" /></svg>
                    <svg class="icon-sound" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5z" /><path d="M15.5 8.5a5 5 0 0 1 0 7" /><path d="M19 5a10 10 0 0 1 0 14" /></svg>
                  </button>
                  <button type="button" class="video-btn" data-video-fullscreen aria-label="Volledig scherm">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3" /><path d="M21 8V5a2 2 0 0 0-2-2h-3" /><path d="M3 16v3a2 2 0 0 0 2 2h3" /><path d="M16 21h3a2 2 0 0 0 2-2v-3" /></svg>
                  </button>
                </div>
              </div>
            ) : (
              <button type="button" class="media-main photo-btn" data-index="0" aria-label="Foto 1 vergroten">
                <img src={imageUrl(photos[0], 1280)} srcset={imageSrcset(photos[0], [640, 1280])} sizes="(max-width: 900px) 100vw, 66vw" alt={`${name} — foto 1`} class="media-img" fetchpriority="high" />
              </button>
            )}
            {thumbs.map((src, i) => {
              const index = i + thumbOffset;
              const isLast = i === thumbs.length - 1 && photos.length > thumbs.length + thumbOffset;
              return (
                <button type="button" class="media-thumb photo-btn" data-index={index} aria-label={`Foto ${index + 1} vergroten`}>
                  <img src={imageUrl(src, 480)} srcset={imageSrcset(src, [480])} sizes="(max-width: 900px) 50vw, 22vw" alt={`${name} — foto ${index + 1}`} loading="lazy" decoding="async" class="media-img" />
                  {isLast && <span class="media-more">Alle {photos.length} foto's</span>}
                </button>
              );
            })}
          </section>
        )}

        <div class="layout">
          <!-- Hoofdkolom -->
          <div class="main">
            {restaurant.description && (
              <section class="block">
                <h2>Over {name}</h2>
                <p class="description">{restaurant.description}</p>
              </section>
            )}

            {(menuImages.length > 0 || menuLink) && (
              <section class="block" id="menu">
                <h2>Menukaart</h2>
                {menuImages.length > 0 && (
                  <div class="menu-grid">
                    {menuImages.map((src, i) => (
                      <a href={src} data-track="open_menu" target="_blank" rel="noopener noreferrer" class="menu-item">
                        <img src={imageUrl(src, 480)} alt={`Menukaart ${name} — pagina ${i + 1}`} loading="lazy" decoding="async" />
                      </a>
                    ))}
                  </div>
                )}
                {menuLink && (
                  <a href={menuLink} data-track="open_menu" class="text-link" target="_blank" rel="noopener noreferrer">Bekijk de menukaart op de website van {name} →</a>
                )}
              </section>
            )}

            {(facilities.length > 0 || allergies.length > 0) && (
              <section class="block">
                {facilities.length > 0 && (
                  <>
                    <h2>Voorzieningen</h2>
                    <ul class="chips">{facilities.map((f) => <li>{f}</li>)}</ul>
                  </>
                )}
                {allergies.length > 0 && (
                  <>
                    <h3 class="subhead">Dieetwensen &amp; allergieën</h3>
                    <ul class="chips">{allergies.map((a) => <li>{a}</li>)}</ul>
                  </>
                )}
              </section>
            )}

            <!-- Reviews -->
            <section class="block" id="reviews">
              <div class="reviews-head">
                <h2>Reviews{reviewCount > 0 ? ` (${reviewCount})` : ''}</h2>
                <a class="btn btn-ghost btn-sm" href={`${canonicalPath}/review`} rel="nofollow">Schrijf een review</a>
              </div>

              {stats && stats.count > 0 && (
                <div class="summary">
                  <div class="summary-score">
                    {score !== null && <span class="big-score">{formatScore(score)}</span>}
                    {score !== null && <RatingStars rating={score} size={20} />}
                    <span class="muted">{reviewCount === 1 ? '1 review' : `${reviewCount} reviews`}</span>
                  </div>
                  <div class="summary-bars" aria-label="Verdeling van de beoordelingen">
                    {[5, 4, 3, 2, 1].map((stars) => {
                      const count = stats.distribution[stars - 1];
                      return (
                        <div class="bar-row">
                          <span class="bar-label">{stars} {stars === 1 ? 'ster' : 'sterren'}</span>
                          <span class="bar"><span class="bar-fill" style={`width:${(count / maxDistribution) * 100}%`} /></span>
                          <span class="bar-count">{count}</span>
                        </div>
                      );
                    })}
                  </div>
                  <dl class="summary-aspects">
                    {stats.aspects.map((a) => (
                      <div class="aspect-row">
                        <dt>{a.label}</dt>
                        <dd>
                          {a.average !== null ? (
                            <>
                              <RatingStars rating={a.average} size={12} />
                              <span>{formatScore(a.average)}</span>
                            </>
                          ) : (
                            <span class="muted">—</span>
                          )}
                        </dd>
                      </div>
                    ))}
                  </dl>
                </div>
              )}

              {reviewPage === null ? (
                <p class="muted empty">Reviews kunnen op dit moment niet geladen worden.</p>
              ) : reviews.length === 0 ? (
                <div class="empty-reviews">
                  <p><strong>Nog geen reviews.</strong> Ben jij hier geweest? <a href={`${canonicalPath}/review`} rel="nofollow">Deel als eerste je ervaring.</a></p>
                </div>
              ) : (
                <>
                  <div id="review-list">
                    {reviews.map((review) => <ReviewCard review={review} />)}
                  </div>
                  {reviewPage.hasMore && (
                    <button
                      type="button"
                      class="btn btn-ghost load-more"
                      id="load-more"
                      data-restaurant={restaurant.id}
                      data-offset={String(reviews.length)}
                    >
                      Meer reviews laden
                    </button>
                  )}
                </>
              )}
            </section>

            {stories.length > 0 && (
              <section class="block" id="stories">
                <h2>Taste Stories</h2>
                <p class="muted section-sub">Foto's van gasten die hier gegeten hebben.</p>
                <div class="stories">
                  {stories.map((story) => (
                    <a href={`/story/${story.id}`} class="story">
                      <img src={imageUrl(story.photo_url!, 480)} alt={story.caption || `Taste Story bij ${name}`} loading="lazy" decoding="async" />
                      <span class="story-meta">
                        <span class="story-author">{story.author.name}</span>
                        {story.created_at && <span class="story-date">{formatReviewDate(story.created_at)}</span>}
                      </span>
                    </a>
                  ))}
                </div>
              </section>
            )}
          </div>

          <!-- Zijbalk -->
          <aside class="side">
            <div class="side-card">
              {reserveUrl && (
                <a class="btn btn-primary btn-block" href={reserveUrl} data-track="make_reservation" target="_blank" rel="noopener noreferrer">Reserveer een tafel</a>
              )}

              {mapEmbedUrl && (
                <div class="map" data-map={mapEmbedUrl} data-map-title={`Kaart: ligging van ${name}`}>
                  <button type="button" class="map-consent" data-map-load>
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" /></svg>
                    <span class="map-consent-title">Kaart tonen</span>
                    <span class="map-consent-note">Laadt Google Maps (Google kan cookies plaatsen)</span>
                  </button>
                </div>
              )}

              <ul class="info-list">
                {restaurant.address && (
                  <li>
                    <span class="info-label">Adres</span>
                    <span>{restaurant.address}{city && !restaurant.address.toLowerCase().includes(city.toLowerCase()) ? `, ${city}` : ''}</span>
                    {routeUrl && <a href={routeUrl} target="_blank" rel="noopener noreferrer" class="text-link">Route plannen →</a>}
                  </li>
                )}
                {phone && phoneHref && (
                  <li>
                    <span class="info-label">Telefoon</span>
                    <a href={phoneHref} class="text-link">{phone}</a>
                  </li>
                )}
                {website && (
                  <li>
                    <span class="info-label">Website</span>
                    <a href={website} data-track="open_website" target="_blank" rel="noopener noreferrer" class="text-link">{displayWebsite(website)}</a>
                  </li>
                )}
                {(instagram || facebook) && (
                  <li>
                    <span class="info-label">Socials</span>
                    <span class="socials">
                      {instagram && <a href={instagram} target="_blank" rel="noopener noreferrer" class="text-link">Instagram</a>}
                      {facebook && <a href={facebook} target="_blank" rel="noopener noreferrer" class="text-link">Facebook</a>}
                    </span>
                  </li>
                )}
              </ul>

              <div class="hours">
                <h2 class="side-title">Openingstijden</h2>
                {hours.length > 0 ? (
                  <table>
                    <tbody>
                      {hours.map((row) => (
                        <tr class:list={{ today: row.day.toLowerCase() === today }}>
                          <th scope="row">{row.day}</th>
                          <td>{row.time}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                ) : (
                  <p class="muted">Openingstijden onbekend</p>
                )}
              </div>
            </div>

            <div class="side-card app-card">
              <img src="/tastory-logo-header.png" alt="" width="40" height="40" class="app-logo" />
              <div>
                <p class="app-title">Bewaar {name} in Tastory</p>
                <p class="muted app-sub">Sla restaurants op, schrijf reviews en deel je Taste Stories.</p>
                <div class="app-actions">
                  <a href={deepLinkUrl} class="text-link" data-app-link>Open in de app</a>
                  <a href={APP_STORE_URL} class="text-link" target="_blank" rel="noopener noreferrer">Download</a>
                </div>
              </div>
            </div>
          </aside>
        </div>

        {nearby.length > 0 && city && (
          <section class="nearby">
            <div class="nearby-head">
              <h2>Meer restaurants in {city}</h2>
              <a href={cityPath(city)} class="text-link">Alle restaurants in {city} →</a>
            </div>
            <div class="nearby-grid">
              {nearby.map((r) => <RestaurantCard restaurant={r} />)}
            </div>
          </section>
        )}
      </div>

      <!-- Mobiel: vaste actiebalk onderin -->
      {(reserveUrl || routeUrl || phoneHref) && (
        <div class="mobile-bar">
          {routeUrl && <a href={routeUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">Route</a>}
          {phoneHref && !reserveUrl && <a href={phoneHref} class="btn btn-ghost">Bellen</a>}
          {reserveUrl && <a href={reserveUrl} data-track="make_reservation" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Reserveer</a>}
        </div>
      )}

      <!-- Fotoweergave -->
      <dialog class="lightbox" id="lightbox" aria-label="Foto's">
        <button type="button" class="lb-close" id="lb-close" aria-label="Sluiten">✕</button>
        <button type="button" class="lb-nav lb-prev" id="lb-prev" aria-label="Vorige foto">‹</button>
        <img id="lb-img" src="" alt="" />
        <button type="button" class="lb-nav lb-next" id="lb-next" aria-label="Volgende foto">›</button>
        <p class="lb-counter" id="lb-counter"></p>
      </dialog>
      <script type="application/json" id="photo-data" set:html={JSON.stringify(photos)} />
    </div>
  )}
</BaseLayout>

<script>
  // Gedrag voor aanbevelingen (alleen ingelogd en niet uitgezet), zoals de
  // app: bekeken, hoe lang, en klikken op menu, website, reserveren, delen.
  import { trackEvent, trackEventOnLeave, upsertRecentView } from '../../lib/tracking';

  const pageEl = document.querySelector<HTMLElement>('[data-restaurant-id]');
  const trackedId = pageEl?.dataset.restaurantId;
  if (trackedId) {
    const cuisine = pageEl!.dataset.restaurantCuisine || null;
    const startedAt = Date.now();
    trackEvent({ event: 'view_restaurant', restaurantId: trackedId, cuisine });
    upsertRecentView(trackedId);
    let durationSent = false;
    const sendDuration = () => {
      if (durationSent) return;
      durationSent = true;
      trackEventOnLeave({
        event: 'view_restaurant_duration',
        restaurantId: trackedId,
        cuisine,
        durationSeconds: Math.round((Date.now() - startedAt) / 1000),
      });
    };
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') sendDuration();
    });
    window.addEventListener('pagehide', sendDuration);
    document.querySelectorAll<HTMLElement>('[data-track]').forEach((el) => {
      el.addEventListener('click', () =>
        trackEvent({ event: el.dataset.track!, restaurantId: trackedId, cuisine }),
      );
    });
  }

  // Delen: native deelmenu op telefoon, anders link kopiëren.
  const shareBtn = document.getElementById('share-btn');
  const shareLabel = document.getElementById('share-label');
  shareBtn?.addEventListener('click', async () => {
    const url = shareBtn.dataset.url ?? location.href;
    const title = shareBtn.dataset.title ?? document.title;
    if (navigator.share) {
      try {
        await navigator.share({ title, url });
      } catch {
        /* geannuleerd */
      }
      return;
    }
    try {
      await navigator.clipboard.writeText(url);
      if (shareLabel) {
        shareLabel.textContent = 'Link gekopieerd';
        setTimeout(() => (shareLabel.textContent = 'Delen'), 2000);
      }
    } catch {
      window.prompt('Kopieer deze link:', url);
    }
  });

  // "Open in de app": zonder app gebeurt er niets, dus na even wachten door
  // naar de App Store.
  document.querySelectorAll<HTMLAnchorElement>('[data-app-link]').forEach((link) => {
    link.addEventListener('click', () => {
      const timer = setTimeout(() => {
        if (!document.hidden) location.href = 'https://apps.apple.com/nl/app/tastory/id6762256086';
      }, 1500);
      document.addEventListener('visibilitychange', () => clearTimeout(timer), { once: true });
    });
  });

  // Google Maps pas laden na een klik (Google plaatst cookies, daar is
  // toestemming voor nodig). De keuze wordt onthouden voor volgende pagina's.
  const MAP_CONSENT_KEY = 'tastory_maps_consent';
  const mapBox = document.querySelector<HTMLElement>('[data-map]');
  const loadMap = () => {
    if (!mapBox?.dataset.map) return;
    const iframe = document.createElement('iframe');
    iframe.src = mapBox.dataset.map;
    iframe.title = mapBox.dataset.mapTitle ?? 'Kaart';
    iframe.loading = 'lazy';
    iframe.referrerPolicy = 'no-referrer-when-downgrade';
    iframe.allowFullscreen = true;
    mapBox.replaceChildren(iframe);
  };
  let mapConsent = false;
  try {
    mapConsent = localStorage.getItem(MAP_CONSENT_KEY) === '1';
  } catch {
    /* geen opslag beschikbaar */
  }
  if (mapConsent) loadMap();
  mapBox?.querySelector('[data-map-load]')?.addEventListener('click', () => {
    try {
      localStorage.setItem(MAP_CONSENT_KEY, '1');
    } catch {
      /* geen opslag beschikbaar */
    }
    loadMap();
  });

  // Restaurantvideo: geluid aan/uit, en klikken = volledig scherm met geluid
  // en de normale bediening (zoals in de app). iPhone kent alleen
  // webkitEnterFullscreen op de video zelf.
  const videoWrap = document.querySelector<HTMLElement>('[data-video-wrap]');
  const video = videoWrap?.querySelector('video') as
    | (HTMLVideoElement & { webkitEnterFullscreen?: () => void })
    | null;
  const soundBtn = videoWrap?.querySelector<HTMLButtonElement>('[data-video-sound]');
  const setSoundState = () => {
    if (!video || !soundBtn) return;
    videoWrap!.classList.toggle('sound-on', !video.muted);
    soundBtn.setAttribute('aria-pressed', String(!video.muted));
    soundBtn.setAttribute('aria-label', video.muted ? 'Geluid aan' : 'Geluid uit');
  };
  soundBtn?.addEventListener('click', () => {
    if (!video) return;
    video.muted = !video.muted;
    if (!video.muted) void video.play().catch(() => {});
    setSoundState();
  });

  let mutedBeforeFullscreen = true;
  const openFullscreen = () => {
    if (!video) return;
    mutedBeforeFullscreen = video.muted;
    video.muted = false;
    video.controls = true;
    void video.play().catch(() => {});
    if (video.requestFullscreen) {
      video.requestFullscreen().catch(() => {
        video.webkitEnterFullscreen?.();
      });
    } else {
      video.webkitEnterFullscreen?.();
    }
  };
  const closedFullscreen = () => {
    if (!video) return;
    video.controls = false;
    video.muted = mutedBeforeFullscreen;
    void video.play().catch(() => {});
    setSoundState();
  };
  video?.addEventListener('click', openFullscreen);
  videoWrap?.querySelector('[data-video-fullscreen]')?.addEventListener('click', openFullscreen);
  document.addEventListener('fullscreenchange', () => {
    if (!document.fullscreenElement) closedFullscreen();
  });
  video?.addEventListener('webkitendfullscreen', closedFullscreen);

  // Meer reviews laden (HTML-fragment van /partials/reviews).
  const loadMore = document.getElementById('load-more') as HTMLButtonElement | null;
  const reviewList = document.getElementById('review-list');
  loadMore?.addEventListener('click', async () => {
    if (!reviewList) return;
    const restaurant = loadMore.dataset.restaurant ?? '';
    const offset = Number(loadMore.dataset.offset ?? '0');
    loadMore.disabled = true;
    loadMore.textContent = 'Laden…';
    try {
      const res = await fetch(`/partials/reviews?restaurant=${encodeURIComponent(restaurant)}&offset=${offset}`);
      if (!res.ok) throw new Error(String(res.status));
      const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
      const wrapper = doc.querySelector('[data-has-more]');
      const cards = wrapper ? Array.from(wrapper.children) : [];
      cards.forEach((card) => reviewList.appendChild(document.importNode(card, true)));
      loadMore.dataset.offset = String(offset + cards.length);
      if (wrapper?.getAttribute('data-has-more') !== 'true' || cards.length === 0) {
        loadMore.remove();
        return;
      }
      loadMore.textContent = 'Meer reviews laden';
    } catch {
      loadMore.textContent = 'Opnieuw proberen';
    } finally {
      loadMore.disabled = false;
    }
  });

  // Fotoweergave met pijltjes en toetsenbord.
  const photos: string[] = JSON.parse(document.getElementById('photo-data')?.textContent ?? '[]');
  const lightbox = document.getElementById('lightbox') as HTMLDialogElement | null;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement | null;
  const lbCounter = document.getElementById('lb-counter');
  let current = 0;
  const show = (index: number) => {
    if (!lbImg || photos.length === 0) return;
    current = (index + photos.length) % photos.length;
    lbImg.src = photos[current];
    lbImg.alt = `Foto ${current + 1} van ${photos.length}`;
    if (lbCounter) lbCounter.textContent = `${current + 1} / ${photos.length}`;
  };
  document.querySelectorAll<HTMLElement>('.photo-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      show(Number(btn.dataset.index ?? '0'));
      lightbox?.showModal();
    });
  });
  document.getElementById('lb-close')?.addEventListener('click', () => lightbox?.close());
  document.getElementById('lb-prev')?.addEventListener('click', () => show(current - 1));
  document.getElementById('lb-next')?.addEventListener('click', () => show(current + 1));
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) lightbox.close();
  });
  lightbox?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
</script>

<style>
  /* global.css geeft elke <section> veel padding (voor de marketingpagina's). */
  section {
    padding: 0;
    max-width: none;
    margin: 0;
  }
  .page {
    padding: 96px 0 var(--space-3xl);
    min-height: 70vh;
  }
  .page.partner {
    background-image:
      linear-gradient(to bottom, rgba(245, 235, 221, 0.86), var(--beige) 520px),
      var(--partner-bg);
    background-size: 100% auto;
    background-repeat: no-repeat;
  }
  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }
  .container.narrow {
    max-width: 640px;
  }
  .muted {
    color: var(--text-muted);
  }

  /* Knoppen */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    font-family: var(--sans);
    font-weight: 500;
    font-size: var(--text-sm);
    padding: 0.7rem 1.2rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    cursor: pointer;
    border: 1px solid transparent;
    transition:
      background 0.2s,
      border-color 0.2s;
    white-space: nowrap;
  }
  .btn-primary {
    background: var(--orange);
    color: #fff;
  }
  .btn-primary:hover {
    background: var(--orange-dark);
  }
  .btn-ghost {
    background: var(--white);
    color: var(--text);
    border-color: var(--beige-deeper);
  }
  .btn-ghost:hover {
    border-color: var(--brown);
  }
  .btn-sm {
    padding: 0.45rem 0.85rem;
  }
  .btn-block {
    width: 100%;
  }
  .btn:focus-visible,
  .text-link:focus-visible,
  .photo-btn:focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: 2px;
  }
  .text-link {
    color: var(--brown-dark);
    font-weight: 500;
    text-decoration: none;
  }
  .text-link:hover {
    text-decoration: underline;
  }

  /* Kruimelpad */
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    gap: 0.35rem;
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-md);
  }
  .breadcrumbs li + li::before {
    content: '›';
    margin-right: 0.35rem;
  }
  .breadcrumbs a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    color: var(--text);
    text-decoration: underline;
  }

  /* Kop */
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }
  .name {
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.1;
    color: var(--text);
  }
  .head-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }
  .head-score {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text);
    text-decoration: none;
    margin-right: 0.35rem;
  }
  .head-score:hover .muted {
    text-decoration: underline;
  }
  .tag {
    font-size: var(--text-xs);
    font-weight: 500;
    background: var(--white);
    border: 1px solid var(--beige-deeper);
    padding: 0.25rem 0.7rem;
    border-radius: 100px;
  }
  .tag-partner {
    background: var(--orange);
    border-color: var(--orange);
    color: #fff;
  }
  .head-actions {
    display: flex;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  /* Media */
  .media {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 8px;
    height: clamp(280px, 42vw, 460px);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: var(--space-2xl);
  }
  .media.thumbs-0 {
    grid-template-columns: 1fr;
    grid-template-rows: 1fr;
  }
  .media.thumbs-2 {
    grid-template-columns: 2fr 1fr;
  }
  .media-main {
    grid-row: 1 / -1;
    position: relative;
  }
  .photo-btn {
    padding: 0;
    border: 0;
    background: var(--beige-dark);
    cursor: zoom-in;
    position: relative;
    overflow: hidden;
  }
  .media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s;
  }
  .photo-btn:hover .media-img {
    transform: scale(1.03);
  }
  .media-more {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(26, 18, 8, 0.5);
    color: #fff;
    font-weight: 500;
  }
  .video {
    cursor: zoom-in;
  }
  .video-controls {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: flex;
    gap: 8px;
  }
  .video-btn {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(20, 14, 8, 0.55);
    backdrop-filter: blur(6px);
    color: #fff;
    cursor: pointer;
    transition: background 0.2s;
  }
  .video-btn:hover {
    background: rgba(20, 14, 8, 0.75);
  }
  .video-btn:focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: 2px;
  }
  .icon-sound,
  .video-wrap.sound-on .icon-muted {
    display: none;
  }
  .video-wrap.sound-on .icon-sound {
    display: block;
  }

  /* Indeling */
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: var(--space-2xl);
    align-items: start;
  }
  .block {
    margin-bottom: var(--space-2xl);
  }
  .block h2,
  .nearby h2 {
    font-family: var(--serif);
    font-size: var(--text-2xl);
    color: var(--text);
    margin-bottom: var(--space-md);
  }
  .subhead {
    font-size: var(--text-base);
    font-weight: 500;
    margin: var(--space-lg) 0 var(--space-sm);
  }
  .section-sub {
    margin: -0.5rem 0 var(--space-md);
    font-size: var(--text-sm);
  }
  .description {
    line-height: 1.75;
    white-space: pre-line;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
  }
  .chips li {
    background: var(--white);
    border: 1px solid var(--beige-deeper);
    border-radius: 100px;
    padding: 0.35rem 0.8rem;
    font-size: var(--text-sm);
  }
  .menu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.6rem;
    margin-bottom: var(--space-md);
  }
  .menu-item img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius-sm);
    display: block;
    border: 1px solid var(--beige-deeper);
  }

  /* Reviews */
  .reviews-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
  }
  .summary {
    display: grid;
    grid-template-columns: auto 1fr 1fr;
    gap: var(--space-xl);
    background: var(--white);
    border: 1px solid var(--beige-dark);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    margin-bottom: var(--space-md);
  }
  .summary-score {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }
  .big-score {
    font-family: var(--serif);
    font-size: 3rem;
    line-height: 1;
    font-weight: 600;
  }
  .summary-bars {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    justify-content: center;
  }
  .bar-row {
    display: grid;
    grid-template-columns: 4.8rem 1fr 2rem;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
  }
  .bar {
    height: 8px;
    background: var(--beige-dark);
