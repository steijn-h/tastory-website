---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { cacheStaticPage } from '../../lib/cache';

cacheStaticPage(Astro);

---

<BaseLayout
  title="Meld je aan als restaurant — Tastory"
  description="Meld jouw restaurant aan bij Tastory en presenteer jezelf via kwalitatieve videocontent aan de juiste gasten."
>
  <PageHero
    title="Aanmelden als <em>restaurant</em>"
    description="Presenteer jouw restaurant met een representatief gepersonaliseerd restaurantprofiel en bereik gasten die écht bij jouw restaurant passen. Vul je gegevens in en we nemen zo snel mogelijk contact op over de mogelijkheden."
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: 'Meld je aan als restaurant — Tastory',
      url: 'https://www.tastory.nl/aanmelden/restaurant',
      description:
        'Meld jouw restaurant aan bij Tastory en presenteer jezelf via kwalitatieve videocontent aan de juiste gasten.',
      inLanguage: 'nl-NL',
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.tastory.nl' },
          {
            '@type': 'ListItem',
            position: 2,
            name: 'Aanmelden als restaurant',
            item: 'https://www.tastory.nl/aanmelden/restaurant',
          },
        ],
      },
    })}
  />
  <section class="signup-section">
    <div class="signup-wrapper reveal">
      <form class="signup-form" id="signup-form" aria-label="Aanmeldformulier restaurant">
        <div class="form-group">
          <label for="name">Naam *</label>
          <input type="text" id="name" name="name" required />
        </div>
        <div class="form-group">
          <label for="company">Bedrijfsnaam *</label>
          <input type="text" id="company" name="company" required />
        </div>
        <div class="form-group">
          <label for="email">E-mailadres *</label>
          <input type="email" id="email" name="email" required />
        </div>
        <div class="form-group">
          <label for="phone">Telefoonnummer <span class="optional">(optioneel)</span></label>
          <input type="tel" id="phone" name="phone" />
        </div>
        <!-- Verborgen veld: alleen bots vullen dit in. -->
        <div class="hp" aria-hidden="true">
          <label for="company_website">Laat dit veld leeg</label>
          <input id="company_website" name="company_website" tabindex="-1" autocomplete="off" />
        </div>
        <button type="submit" class="btn-primary">Aanmelden als restaurant</button>
        <div class="signup-feedback" id="signup-feedback" role="status"></div>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  // Zelfde aanmeldroute als /restaurant-aanmelden: melding aan Tastory en een
  // bevestiging per e-mail aan de aanmelder.
  const form = document.getElementById('signup-form') as HTMLFormElement;
  const feedback = document.getElementById('signup-feedback') as HTMLDivElement;
  const submitBtn = form.querySelector('button') as HTMLButtonElement;
  let startedAt = Date.now();

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const value = (key: string) => String(data.get(key) ?? '').trim();

    submitBtn.disabled = true;
    submitBtn.textContent = 'Aanmelden...';
    feedback.className = 'signup-feedback';
    feedback.textContent = '';

    try {
      const res = await fetch('/api/restaurant-aanmelden', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          kind: 'partner',
          name: value('name'),
          restaurant: value('company'),
          email: value('email'),
          phone: value('phone'),
          company_website: value('company_website'),
          startedAt,
        }),
      });
      const result = await res.json().catch(() => ({}));
      if (!res.ok || !result.ok) throw new Error(result.message ?? 'Er ging iets mis. Probeer het later opnieuw.');
      feedback.textContent =
        'Bedankt voor je aanmelding! Je ontvangt een bevestiging per e-mail en we nemen zo snel mogelijk contact met je op.';
      feedback.className = 'signup-feedback signup-feedback--success';
      form.reset();
      startedAt = Date.now();
    } catch (err) {
      feedback.textContent = (err as Error).message;
      feedback.className = 'signup-feedback signup-feedback--error';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Aanmelden als restaurant';
    }
  });
</script>

<style>
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .signup-section {
    max-width: 600px;
  }

  .signup-wrapper {
    background: var(--white);
    border: 1px solid rgba(136, 101, 69, 0.08);
    border-radius: var(--radius-lg);
    padding: 3rem;
    box-shadow: var(--shadow-md);
  }

  .signup-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .form-group label {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--text);
  }

  .optional {
    font-weight: 400;
    color: var(--text-muted);
    font-size: 0.9em;
  }

  .form-group input {
    font-family: var(--sans);
    font-size: var(--text-base);
    padding: 0.9rem 1.2rem;
    border: 1px solid rgba(136, 101, 69, 0.15);
    border-radius: var(--radius-sm);
    background: var(--beige);
    color: var(--text);
    outline: none;
    transition: border-color 0.3s;
  }

  .form-group input:focus {
    border-color: var(--orange);
  }

  .signup-feedback {
    font-size: var(--text-base);
    min-height: 1.5rem;
    transition: all 0.3s;
  }

  .signup-feedback--success {
    color: #2e7d32;
  }

  .signup-feedback--error {
    color: #c62828;
  }

  @media (max-width: 640px) {
    .signup-wrapper {
      padding: 2rem 1.5rem;
    }
  }
</style>
