---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import StatsBar from '../components/StatsBar.astro';
import ProblemSolution from '../components/ProblemSolution.astro';
import Features from '../components/Features.astro';
import Testimonials from '../components/Testimonials.astro';
import Cta from '../components/Cta.astro';
import { stats, features, testimonials } from '../data/home';
---

<BaseLayout
  title="Tastory — Ontdek restaurants in de buurt die écht bij jou passen."
  description="Tastory is dé app om restaurants in de buurt te ontdekken. Beleef de sfeer via professionele content en maak de juiste keuze die bij jou past. Gratis voor iOS en Android."
>
  <Hero />
  <StatsBar stats={stats} />
  <ProblemSolution />
  <Features features={features} />
  <Testimonials testimonials={testimonials} />
  <Cta />
  <script
    type="application/ld+json"
    set:html={JSON.stringify([
      {
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'Tastory',
        url: 'https://www.tastory.nl',
        logo: 'https://www.tastory.nl/tastory-logo.png',
        alternateName: 'Tastory restaurantplatform',
        description:
          'Tastory is een Nederlands platform om restaurants te zoeken en te ontdekken, met video, foto’s en geverifieerde reviews van gasten. Via de app en tastory.nl.',
        foundingDate: '2025',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'Hutteweg 32',
          addressLocality: 'Ulft',
          postalCode: '7071 BV',
          addressCountry: 'NL',
        },
        contactPoint: {
          '@type': 'ContactPoint',
          telephone: '+31624774605',
          email: 'Info@tastory.nl',
          contactType: 'customer service',
          availableLanguage: 'Dutch',
        },
        sameAs: [
          'https://apps.apple.com/nl/app/tastory/id6762256086',
          'https://instagram.com/Tastory.app',
        ],
        areaServed: {
          '@type': 'Country',
          name: 'Nederland',
        },
        knowsAbout: [
          'restaurants',
          'toprestaurants',
          'restaurantbeleving',
          'restaurants in de buurt',
          'restaurantapp',
          'restaurantreviews',
          'restaurant zoeken',
        ],
      },
      {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'Tastory',
        url: 'https://www.tastory.nl',
        description: 'Ontdek restaurants in de buurt die écht bij jou passen.',
        inLanguage: 'nl-NL',
        speakable: {
          '@type': 'SpeakableSpecification',
          cssSelector: ['.hero h1', '.hero-desc'],
        },
        potentialAction: {
          '@type': 'SearchAction',
          target: {
            '@type': 'EntryPoint',
            urlTemplate: 'https://www.tastory.nl/restaurants?q={search_term_string}',
          },
          'query-input': 'required name=search_term_string',
        },
      },
      {
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'Tastory',
        operatingSystem: 'iOS, Android',
        applicationCategory: 'LifestyleApplication',
        description:
          'Ontdek restaurants in de buurt via video. Beleef de sfeer van toprestaurants voordat je reserveert.',
        offers: {
          '@type': 'Offer',
          price: '0',
          priceCurrency: 'EUR',
        },
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: '4.8',
          ratingCount: '120',
        },
      },
    ])}
  />
</BaseLayout>
