---
// Stadspagina, bijv. /restaurants/utrecht — belangrijk om gevonden te worden
// op zoekopdrachten als "restaurant Utrecht".
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import RestaurantGrid from '../../components/RestaurantGrid.astro';
import BackLink from '../../components/BackLink.astro';
import { getAllRestaurants, groupByCity, restaurantPath } from '../../lib/restaurants';
import { SITE_URL } from '../../lib/links';
import { CITY_PHOTOS } from '../../data/city-photos';
import {
  groupByCuisine,
  MIN_RESTAURANTS_PER_CUISINE_PAGE,
  MIN_RESTAURANTS_PER_REGION_CUISINE_PAGE,
  REGION_SLUG,
} from '../../lib/cuisine';
import { nearestCities } from '../../lib/geo';
import { priceLabel, priceRange } from '../../lib/format';

const stad = (Astro.params.stad ?? '').toLowerCase();
const all = await getAllRestaurants();
const cities = all ? groupByCity(all) : [];
const group = cities.find((c) => c.slug === stad) ?? null;

if (all === null) {
  Astro.response.status = 503;
} else if (!group) {
  Astro.response.status = 404;
} else {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400');
}

const name = group?.name ?? 'Onbekende stad';
const photo = group ? CITY_PHOTOS[group.slug] : undefined;
const restaurants = group?.restaurants ?? [];
const rated = restaurants.filter((r) => (r.weighted_score ?? 0) > 0);
const intro = `${restaurants.length} ${restaurants.length === 1 ? 'restaurant' : 'restaurants'} in ${name}${
  rated.length > 0 ? `, waarvan ${rated.length} beoordeeld door Tastory-gebruikers` : ''
}. Gesorteerd op beoordeling.`;
const cuisineLinks = groupByCuisine(restaurants).filter(
  (c) => c.restaurants.length >= MIN_RESTAURANTS_PER_CUISINE_PAGE,
);

// Feitelijk overzicht van deze plaats (alleen eigen gegevens, per plaats
// anders): keukens met links, sfeer, prijsklassen en voorzieningen.
const regionCuisines = new Set(
  (all ? groupByCuisine(all) : [])
    .filter((c) => c.restaurants.length >= MIN_RESTAURANTS_PER_REGION_CUISINE_PAGE)
    .map((c) => c.slug),
);
const cuisineFacts = groupByCuisine(restaurants).map((c) => ({
  name: c.name,
  count: c.restaurants.length,
  href:
    c.restaurants.length >= MIN_RESTAURANTS_PER_CUISINE_PAGE
      ? `/restaurants/${stad}/${c.slug}`
      : regionCuisines.has(c.slug)
        ? `/restaurants/${REGION_SLUG}/${c.slug}`
        : null,
}));
const vibeCounts = new Map<string, number>();
for (const r of restaurants) {
  for (const v of (r.vibe ?? '')
    .split(',')
    .map((x) => x.trim().toLowerCase())
    .filter(Boolean)) {
    vibeCounts.set(v, (vibeCounts.get(v) ?? 0) + 1);
  }
}
const vibeFacts = [...vibeCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 6);
const priceFacts = [1, 2, 3, 4]
  .map((p) => ({ p, n: restaurants.filter((r) => r.price_level === p).length }))
  .filter((x) => x.n > 0);
const countFacility = (word: string) =>
  restaurants.filter((r) => (r.facilities ?? []).some((f) => f.toLowerCase().includes(word)))
    .length;
const facilityFacts = [
  { label: 'met terras', n: countFacility('terras') },
  { label: 'rolstoeltoegankelijk', n: countFacility('rolstoel') },
  { label: 'met parkeren', n: countFacility('parkeer') },
  { label: 'met vegetarische opties', n: countFacility('vegetar') },
].filter((f) => f.n > 0);
const nearby = group ? nearestCities(group, cities) : [];
const otherCities = cities
  .filter((c) => c.slug !== stad)
  .sort((a, b) => b.restaurants.length - a.restaurants.length)
  .slice(0, 12);
// Alleen beloven wat er staat: nog geen 'beste' (er zijn nauwelijks scores)
// en 'reviews' pas als er reviews zijn.
const hasReviews = restaurants.some(
  (r) => (r.published_review_count ?? 0) + (r.pending_review_count ?? 0) > 0,
);
const topCuisineNames = cuisineFacts.slice(0, 3).map((c) => c.name);
const title = group
  ? `Restaurants in ${name} (${restaurants.length}) — uit eten in ${name}${hasReviews ? ', met reviews' : ''} | Tastory`
  : 'Stad niet gevonden | Tastory';
const description = group
  ? `${restaurants.length} restaurants in ${name} op Tastory${
      topCuisineNames.length ? `, o.a. ${topCuisineNames.join(', ')}` : ''
    }. Met foto's, adres, openingstijden en prijsklasse per restaurant.`
  : 'Deze stad staat (nog) niet op Tastory.';

const itemList = group
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: `Restaurants in ${name}`,
      numberOfItems: restaurants.length,
      itemListElement: restaurants.slice(0, 30).map((r, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${SITE_URL}${restaurantPath(r)}`,
        name: r.name ?? undefined,
      })),
    }
  : null;
const breadcrumbLd = group
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
        { '@type': 'ListItem', position: 2, name: 'Restaurants', item: `${SITE_URL}/restaurants` },
        { '@type': 'ListItem', position: 3, name, item: `${SITE_URL}/restaurants/${group.slug}` },
      ],
    }
  : null;
---

<BaseLayout
  title={title}
  description={description}
  keywords={group
    ? [
        `restaurant ${name}`,
        `restaurants ${name}`,
        `uit eten ${name}`,
        `beste restaurants ${name}`,
        'Tastory',
      ]
    : []}
  noindex={!group}
>
  {itemList && <script type="application/ld+json" set:html={JSON.stringify(itemList)} />}
  {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}

  <div class="page">
    <div class="container">
      <BackLink href="/restaurants" label="Alle restaurants" />
      <nav class="breadcrumbs" aria-label="Kruimelpad">
        <a href="/">Home</a> › <a href="/restaurants">Restaurants</a>{
          group && (
            <>
              {' '}
              › <span aria-current="page">{name}</span>
            </>
          )
        }
      </nav>

      {
        all === null ? (
          <p class="state">
            Restaurants kunnen op dit moment niet geladen worden. Probeer het over een paar minuten
            opnieuw.
          </p>
        ) : !group ? (
          <div class="state">
            <h1>Deze stad staat (nog) niet op Tastory</h1>
            <p>
              <a href="/restaurants">Bekijk alle restaurants →</a>
            </p>
          </div>
        ) : (
          <>
            {photo && (
              <figure class="city-photo">
                <img
                  src={photo.src}
                  alt={`Centrum van ${name}`}
                  width="640"
                  height="480"
                  fetchpriority="high"
                />
                <figcaption>
                  Foto:{' '}
                  <a href={photo.source} target="_blank" rel="noopener noreferrer">
                    {photo.author}
                  </a>
                  , {photo.license}
                </figcaption>
              </figure>
            )}
            <header class="head">
              <h1>{name}</h1>
              <p>{intro}</p>
            </header>
            <RestaurantGrid restaurants={restaurants} searchPlaceholder={`Zoek in ${name}…`} />
          </>
        )
      }

      {
        group && (
          <section class="facts" aria-labelledby="facts-title">
            <h2 id="facts-title">Uit eten in {name}: het aanbod</h2>
            <dl>
              {cuisineFacts.length > 0 && (
                <div>
                  <dt>Keukens</dt>
                  <dd>
                    {cuisineFacts.map((c, i) => (
                      <span class="fact">
                        {c.href ? <a href={c.href}>{c.name}</a> : c.name}
                        {` (${c.count})${i < cuisineFacts.length - 1 ? ', ' : ''}`}
                      </span>
                    ))}
                  </dd>
                </div>
              )}
              {vibeFacts.length > 0 && (
                <div>
                  <dt>Sfeer</dt>
                  <dd>{vibeFacts.map(([v, n]) => `${v} (${n})`).join(', ')}</dd>
                </div>
              )}
              {priceFacts.length > 0 && (
                <div>
                  <dt>Prijs</dt>
                  <dd>
                    {priceFacts
                      .map((x) => `${x.n}× ${priceLabel(x.p)} (${priceRange(x.p)})`)
                      .join(', ')}
                  </dd>
                </div>
              )}
              {facilityFacts.length > 0 && (
                <div>
                  <dt>Voorzieningen</dt>
                  <dd>{facilityFacts.map((f) => `${f.n} ${f.label}`).join(', ')}</dd>
                </div>
              )}
            </dl>
          </section>
        )
      }

      {
        nearby.length > 0 && (
          <nav class="others" aria-label={`Plaatsen in de buurt van ${name}`}>
            <h2>Restaurants in de buurt van {name}</h2>
            <ul>
              {nearby.map(({ city: c, km }) => (
                <li>
                  <a href={`/restaurants/${c.slug}`}>
                    {c.name} <span>{km} km</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      {
        group && cuisineLinks.length > 0 && (
          <nav class="others" aria-label={`Restaurants in ${name} per keuken`}>
            <h2>Restaurants in {name} per keuken</h2>
            <ul>
              {cuisineLinks.map((c) => (
                <li>
                  <a href={`/restaurants/${group.slug}/${c.slug}`}>
                    {c.name} <span>{c.restaurants.length}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      {
        otherCities.length > 0 && (
          <nav class="others" aria-label="Andere steden">
            <h2>Andere steden</h2>
            <ul>
              {otherCities.map((c) => (
                <li>
                  <a href={`/restaurants/${c.slug}`}>{c.name}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    padding: 100px 0 var(--space-3xl);
    min-height: 80vh;
  }
  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }
  .breadcrumbs {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-md);
  }
  .breadcrumbs a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    text-decoration: underline;
    color: var(--text);
  }
  .city-photo {
    position: relative;
    margin: 0 0 var(--space-lg);
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 16 / 6;
    background: var(--beige-dark);
  }
  .city-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .city-photo figcaption {
    position: absolute;
    right: 0.5rem;
    bottom: 0.4rem;
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.45);
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.65rem;
  }
  .city-photo figcaption a {
    color: inherit;
  }
  @media (max-width: 700px) {
    .city-photo {
      aspect-ratio: 16 / 9;
      border-radius: var(--radius-md);
    }
  }
  .head {
    margin-bottom: var(--space-xl);
  }
  .head h1,
  .state h1 {
    font-family: var(--serif);
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
  }
  .head p {
    color: var(--text-muted);
    margin-top: 0.4rem;
  }
  .state {
    text-align: center;
    color: var(--text-muted);
    padding: var(--space-3xl) 0;
  }
  .state a {
    color: var(--brown-dark);
    font-weight: 500;
  }
  .others {
    margin-top: var(--space-3xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--beige-deeper);
  }
  .others h2 {
    font-family: var(--serif);
    font-size: var(--text-xl);
    margin-bottom: var(--space-sm);
  }
  .others ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
  }
  .others a {
    color: var(--brown-dark);
    text-decoration: none;
    font-size: var(--text-sm);
  }
  .others a:hover {
    text-decoration: underline;
  }
  .others a span {
    color: var(--text-muted);
  }
  /* global.css geeft elke <section> veel padding (voor de marketingpagina's). */
  .facts {
    padding: 0;
    max-width: none;
    margin-top: var(--space-3xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--beige-deeper);
  }
  .facts h2 {
    font-family: var(--serif);
    font-size: var(--text-xl);
    margin-bottom: var(--space-md);
  }
  .facts dl {
    display: grid;
    gap: 0.6rem;
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .facts dl > div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-md);
  }
  .facts dt {
    font-weight: 500;
    color: var(--text);
  }
  .facts dd {
    color: var(--text-muted);
  }
  .facts a {
    color: var(--brown-dark);
  }
  .facts .fact {
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .facts dl > div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
  @media (max-width: 700px) {
    .page {
      padding-top: 84px;
    }
    .container {
      padding: 0 var(--space-md);
    }
  }
</style>
