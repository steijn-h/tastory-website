---
// Overzicht van alle restaurants op Tastory, met zoeken en filters.
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import RestaurantGrid from '../../components/RestaurantGrid.astro';
import VideoShowcase from '../../components/VideoShowcase.astro';
import { getAllRestaurants, groupByCity } from '../../lib/restaurants';
import { SITE_URL } from '../../lib/links';

const restaurants = await getAllRestaurants();
const initialQuery = Astro.url.searchParams.get('q') ?? '';
const cities = restaurants
  ? groupByCity(restaurants).sort((a, b) => b.restaurants.length - a.restaurants.length)
  : [];

if (restaurants) {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400');
} else {
  Astro.response.status = 503;
}
---

<BaseLayout
  title="Restaurants ontdekken — reviews, foto's & menu's | Tastory"
  description="Ontdek de beste restaurants van Nederland op Tastory. Lees eerlijke reviews van gasten, bekijk foto's en menukaarten en reserveer direct."
  keywords={[
    'restaurants',
    'restaurant reviews',
    'beste restaurants Nederland',
    'restaurant zoeken',
    'Tastory',
  ]}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Restaurants — Tastory',
      url: `${SITE_URL}/restaurants`,
      inLanguage: 'nl-NL',
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${SITE_URL}/restaurants?q={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    })}
  />
  <div class="page">
    <div class="container">
      <header class="head">
        <h1>Restaurants</h1>
      </header>

      {restaurants && <VideoShowcase restaurants={restaurants} />}

      {
        cities.length > 0 && (
          <nav class="cities" aria-label="Restaurants per stad">
            <h2>Kies een stad</h2>
            <ul>
              {cities.map((c) => (
                <li>
                  <a href={`/restaurants/${c.slug}`}>
                    {c.name} <span>{c.restaurants.length}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      {
        restaurants === null ? (
          <p class="state">
            Restaurants kunnen op dit moment niet geladen worden. Probeer het over een paar minuten
            opnieuw.
          </p>
        ) : restaurants.length === 0 ? (
          <p class="state">Nog geen restaurants beschikbaar.</p>
        ) : (
          <RestaurantGrid restaurants={restaurants} initialQuery={initialQuery} />
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    padding: 110px 0 var(--space-3xl);
    min-height: 80vh;
  }
  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }
  .head h1 {
    font-family: var(--serif);
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    line-height: 1.1;
  }
  .head p {
    color: var(--text-muted);
    margin-top: 0.4rem;
    max-width: 60ch;
  }
  .cities {
    margin: var(--space-xl) 0;
  }
  .cities h2 {
    font-size: var(--text-base);
    font-weight: 500;
    margin-bottom: var(--space-sm);
  }
  .cities ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cities a {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    padding: 0.45rem 0.9rem;
    background: var(--white);
    border: 1px solid var(--beige-deeper);
    border-radius: 100px;
    text-decoration: none;
    color: var(--text);
    font-size: var(--text-sm);
    transition: border-color 0.2s;
  }
  .cities a:hover {
    border-color: var(--brown);
  }
  .cities span {
    color: var(--text-muted);
    font-size: var(--text-xs);
  }
  .state {
    text-align: center;
    color: var(--text-muted);
    padding: var(--space-3xl) 0;
  }
  @media (max-width: 700px) {
    .page {
      padding-top: 90px;
    }
    .container {
      padding: 0 var(--space-md);
    }
  }
</style>
