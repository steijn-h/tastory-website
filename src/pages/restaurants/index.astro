---
// Overzicht van alle restaurants op Tastory, met zoeken en filters.
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import RestaurantGrid from '../../components/RestaurantGrid.astro';
import Recommendations from '../../components/Recommendations.astro';
import { getAllRestaurants, groupByCity } from '../../lib/restaurants';
import { SITE_URL } from '../../lib/links';

const restaurants = await getAllRestaurants();
const initialQuery = Astro.url.searchParams.get('q') ?? '';
// Op alfabet; in de browser eerst 5 tonen (zie script), alle links staan wel in
// de HTML voor zoekmachines.
const cities = restaurants
  ? groupByCity(restaurants).sort((a, b) => a.name.localeCompare(b.name, 'nl'))
  : [];
const CITIES_STEP = 5;

if (restaurants) {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400');
} else {
  Astro.response.status = 503;
}
---

<BaseLayout
  title="Restaurants ontdekken — reviews, foto's & menu's | Tastory"
  description="Ontdek de beste restaurants van Nederland op Tastory. Lees eerlijke reviews van gasten, bekijk foto's en menukaarten en reserveer direct."
  keywords={[
    'restaurants',
    'restaurant reviews',
    'beste restaurants Nederland',
    'restaurant zoeken',
    'Tastory',
  ]}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Restaurants — Tastory',
      url: `${SITE_URL}/restaurants`,
      inLanguage: 'nl-NL',
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${SITE_URL}/restaurants?q={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    })}
  />
  <div class="page">
    <div class="container">
      <header class="head">
        <h1>Restaurants</h1>
        <div class="suggest">
          <p>Staat jouw favoriete restaurant er niet tussen?</p>
          <a class="suggest-btn" href="/restaurant-aanmelden">Meld het aan</a>
        </div>
      </header>

      <Recommendations />

      {
        cities.length > 0 && (
          <nav class="cities" aria-label="Restaurants per stad" data-cities data-step={CITIES_STEP}>
            <div class="cities-head">
              <h2>Kies een stad</h2>
              {cities.length > CITIES_STEP && (
                <input
                  type="search"
                  class="city-search"
                  placeholder="Zoek een stad…"
                  aria-label="Zoek een stad"
                  autocomplete="off"
                  data-city-search
                />
              )}
            </div>
            <ul>
              {cities.map((c, i) => (
                <li data-name={c.name.toLowerCase()} hidden={i >= CITIES_STEP}>
                  <a href={`/restaurants/${c.slug}`}>
                    {c.name} <span>{c.restaurants.length}</span>
                  </a>
                </li>
              ))}
            </ul>
            <p class="city-empty" data-city-empty hidden>
              Geen stad gevonden.
            </p>
            {cities.length > CITIES_STEP && (
              <button type="button" class="city-more" data-city-more>
                Meer steden
              </button>
            )}
          </nav>
        )
      }

      {
        restaurants === null ? (
          <p class="state">
            Restaurants kunnen op dit moment niet geladen worden. Probeer het over een paar minuten
            opnieuw.
          </p>
        ) : restaurants.length === 0 ? (
          <p class="state">Nog geen restaurants beschikbaar.</p>
        ) : (
          <RestaurantGrid restaurants={restaurants} initialQuery={initialQuery} />
        )
      }
    </div>
  </div>
</BaseLayout>

<script>
  // Steden per 5 tonen, met zoeken. Zonder JavaScript staan de eerste 5 er.
  const nav = document.querySelector<HTMLElement>('[data-cities]');
  if (nav) {
    const step = Number(nav.dataset.step) || 5;
    const items = [...nav.querySelectorAll<HTMLLIElement>('li[data-name]')];
    const search = nav.querySelector<HTMLInputElement>('[data-city-search]');
    const more = nav.querySelector<HTMLButtonElement>('[data-city-more]');
    const empty = nav.querySelector<HTMLElement>('[data-city-empty]')!;
    let shown = step;
    const render = () => {
      const q = (search?.value ?? '').trim().toLowerCase();
      let visible = 0;
      items.forEach((li, i) => {
        li.hidden = q ? !li.dataset.name!.includes(q) : i >= shown;
        if (!li.hidden) visible++;
      });
      empty.hidden = visible > 0;
      if (more) more.hidden = Boolean(q) || shown >= items.length;
    };
    more?.addEventListener('click', () => {
      shown += step;
      render();
    });
    search?.addEventListener('input', render);
    render();
  }
</script>

<style>
  .page {
    padding: 110px 0 var(--space-3xl);
    min-height: 80vh;
  }
  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }
  .head h1 {
    font-family: var(--serif);
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    line-height: 1.1;
  }
  .suggest {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    margin-top: 0.6rem;
  }
  .suggest p {
    color: var(--text-muted);
  }
  .suggest-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    background: var(--orange);
    color: #fff;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s;
  }
  .suggest-btn:hover {
    background: var(--orange-dark);
  }
  .suggest-btn:focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: 2px;
  }
  .cities {
    margin: var(--space-xl) 0;
  }
  .cities-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-md);
    margin-bottom: var(--space-sm);
  }
  .cities h2 {
    font-size: var(--text-base);
    font-weight: 500;
  }
  .city-search {
    width: 220px;
    max-width: 100%;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--beige-deeper);
    border-radius: 100px;
    background: var(--white);
    font: inherit;
    font-size: var(--text-sm);
    color: var(--text);
  }
  .city-search:focus {
    outline: none;
    border-color: var(--brown);
  }
  .city-empty {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  .city-more {
    margin-top: var(--space-sm);
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--brown);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cities ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cities a {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    padding: 0.45rem 0.9rem;
    background: var(--white);
    border: 1px solid var(--beige-deeper);
    border-radius: 100px;
    text-decoration: none;
    color: var(--text);
    font-size: var(--text-sm);
    transition: border-color 0.2s;
  }
  .cities a:hover {
    border-color: var(--brown);
  }
  .cities span {
    color: var(--text-muted);
    font-size: var(--text-xs);
  }
  .state {
    text-align: center;
    color: var(--text-muted);
    padding: var(--space-3xl) 0;
  }
  @media (max-width: 700px) {
    .page {
      padding-top: 90px;
    }
    .container {
      padding: 0 var(--space-md);
    }
    .city-search {
      width: 100%;
    }
  }
</style>
