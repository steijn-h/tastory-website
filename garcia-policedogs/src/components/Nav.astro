---

---

<nav id="navbar" aria-label="Hoofdnavigatie">
  <a href="/" class="logo">
    <img src="/garcia-mark.png" alt="" class="logo-mark" />
    <span class="logo-text">Garcia<em>policedogs</em></span>
  </a>
  <ul class="nav-links">
    <li><a href="/">Welkom</a></li>
    <li><a href="/over-mij">Over mij</a></li>
    <li><a href="/mijn-fokkerij">Mijn fokkerij</a></li>
    <li><a href="/contact" class="nav-cta">Contact</a></li>
  </ul>
  <button
    id="menu-toggle"
    class="menu-toggle"
    aria-expanded="false"
    aria-controls="mobile-menu"
    aria-label="Menu openen"
  >
    <span class="menu-toggle-bar"></span>
    <span class="menu-toggle-bar"></span>
    <span class="menu-toggle-bar"></span>
  </button>
</nav>
<div id="mobile-backdrop" class="mobile-backdrop"></div>
<aside id="mobile-menu" class="mobile-menu" aria-label="Mobiel menu">
  <div class="mobile-menu-inner">
    <span class="mobile-menu-label">Menu</span>
    <a href="/">Welkom</a>
    <a href="/over-mij">Over mij</a>
    <a href="/mijn-fokkerij">Mijn fokkerij</a>
    <a href="/contact">Contact</a>
  </div>
</aside>
<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 1rem 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(17, 17, 17, 0.9);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.3s,
      background 0.3s;
    animation: fadeDown 0.6s ease both;
  }
  nav.scrolled {
    border-bottom-color: var(--line);
    background: rgba(17, 17, 17, 0.97);
  }
  .logo {
    text-decoration: none;
    z-index: 102;
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .logo-mark {
    height: 38px;
    width: 38px;
    object-fit: cover;
    object-position: center 30%;
  }
  .logo-text {
    font-family: var(--display);
    font-size: 1.15rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--paper);
    line-height: 1;
  }
  .logo-text em {
    display: block;
    font-style: normal;
    font-size: 0.6rem;
    letter-spacing: 0.28em;
    color: var(--red);
    margin-top: 0.3rem;
  }
  .nav-links {
    display: flex;
    gap: 2.4rem;
    list-style: none;
    align-items: center;
  }
  .nav-links a {
    color: rgba(242, 241, 237, 0.8);
    text-decoration: none;
    font-family: var(--display);
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    transition: color 0.3s;
    position: relative;
  }
  .nav-links a:not(.nav-cta):hover {
    color: var(--paper);
  }
  .nav-links a:not(.nav-cta)::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--red);
    transition: width 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .nav-links a:not(.nav-cta):hover::after {
    width: 100%;
  }
  .nav-cta {
    background: var(--red);
    color: var(--paper) !important;
    padding: 0.6rem 1.4rem;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 8px 100%, 0 calc(100% - 8px));
    transition:
      background 0.3s,
      transform 0.3s;
  }
  .nav-cta:hover {
    background: var(--red-dark);
    transform: translateY(-1px);
  }
  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    z-index: 102;
    width: 28px;
    height: 24px;
    position: relative;
  }
  .menu-toggle-bar {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--paper);
    transition: all 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    position: absolute;
    left: 2px;
  }
  .menu-toggle-bar:nth-child(1) {
    top: 3px;
  }
  .menu-toggle-bar:nth-child(2) {
    top: 11px;
  }
  .menu-toggle-bar:nth-child(3) {
    top: 19px;
  }
  :global(.menu-open) .menu-toggle-bar:nth-child(1) {
    top: 11px;
    transform: rotate(45deg);
    background: var(--red);
  }
  :global(.menu-open) .menu-toggle-bar:nth-child(2) {
    opacity: 0;
    transform: translateX(10px);
  }
  :global(.menu-open) .menu-toggle-bar:nth-child(3) {
    top: 11px;
    transform: rotate(-45deg);
    background: var(--red);
  }
  .mobile-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    z-index: 98;
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }
  :global(.menu-open) .mobile-backdrop {
    opacity: 1;
    pointer-events: auto;
  }
  .mobile-menu {
    display: none;
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 300px;
    max-width: 85vw;
    background: var(--black-soft);
    z-index: 101;
    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    border-left: 1px solid var(--line);
  }
  :global(.menu-open) .mobile-menu {
    transform: translateX(0);
  }
  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    padding: 6rem 2.5rem 3rem;
    gap: 0.3rem;
  }
  .mobile-menu-label {
    font-family: var(--display);
    font-size: var(--text-xs);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 1rem;
  }
  .mobile-menu a {
    color: var(--paper);
    text-decoration: none;
    font-family: var(--display);
    font-size: 1.4rem;
    text-transform: uppercase;
    padding: 0.7rem 0;
    transition: color 0.3s;
    display: block;
  }
  .mobile-menu a:hover {
    color: var(--red);
  }
  @media (max-width: 768px) {
    nav {
      padding: 0.9rem 1.5rem;
    }
    .logo-text {
      font-size: 1rem;
    }
    .nav-links {
      display: none;
    }
    .menu-toggle {
      display: flex;
    }
    .mobile-backdrop {
      display: block;
    }
    .mobile-menu {
      display: block;
    }
  }
</style>
