---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Garcia Policedogs — Werklijn Nederlandse Herders | Enschede"
  description="Africhting en fokkerij van werklijn Nederlandse Herders vanuit Enschede. Sinds 1990 actief in africhting, sinds 2023 lid van de KNPV."
>
  <section class="hero">
    <div class="hero-inner">
      <p class="kicker">Enschede &middot; KNPV</p>
      <h1 class="hero-title">
        Werklijn Nederlandse Herders.<br />
        Getraind voor <em>het echte werk</em>.
      </h1>
      <p class="hero-desc">
        Sinds 1990 train ik honden voor sport en politiewerk. Sinds 2023 als lid van de Koninklijke
        Nederlandse Politiehond Vereniging &mdash; met mijn eigen honden Luna en Cort&eacute;s
        Garcia.
      </p>
      <div class="hero-actions">
        <a href="/mijn-fokkerij" class="btn-primary">Mijn fokkerij</a>
        <a href="/contact" class="btn-secondary">Neem contact op</a>
      </div>
    </div>
    <img src="/garcia-mark.png" alt="" class="hero-mark" />
  </section>

  <section class="facts">
    <div class="fact reveal">
      <span class="fact-num">1990</span>
      <span class="fact-label">Start africhting bij de SV</span>
    </div>
    <div class="fact reveal">
      <span class="fact-num">SCHH3</span>
      <span class="fact-label">SCHH1 &middot; SCHH2 &middot; IPO1 &middot; SCHH3 behaald</span>
    </div>
    <div class="fact reveal">
      <span class="fact-num">2023</span>
      <span class="fact-label">Lid Koninklijke Nederlandse Politiehond Vereniging</span>
    </div>
    <div class="fact reveal">
      <span class="fact-num">9.5</span>
      <span class="fact-label">Resultaat BKD-examen (op 10)</span>
    </div>
  </section>

  <section class="intro on-paper">
    <div class="intro-grid">
      <div class="reveal">
        <p class="kicker">Over mij</p>
        <h2 class="section-title">Sinds 1990 <em>op het veld</em></h2>
        <p class="section-desc">
          In 1990 begon ik met africhten bij de Duitse Herdershondenvereniging (SV), met mijn hond
          Wolf vom Spanierland. Via SCHH1, SCHH2, IPO1 en SCHH3 groeide dat uit tot een leven met
          werkhonden. In 2023 werd ik lid van de Koninklijke Nederlandse Politiehond Vereniging
          (KNPV). Vandaag train ik Nederlandse Herders, met mijn honden Luna en Cort&eacute;s
          Garcia.
        </p>
        <a href="/over-mij" class="text-link">Lees meer over mij &rarr;</a>
      </div>
    </div>
  </section>

  <section class="breeding-teaser">
    <div class="breeding-grid">
      <div class="reveal">
        <p class="kicker">Mijn fokkerij</p>
        <h2 class="section-title">Werklijn met <em>karakter</em></h2>
        <p class="section-desc">
          Luna (BRN 44862, geboren 3 september 2021) is een middelgrote, atletische Nederlandse
          Herder met een sterke, volle beet. Ze startte haar training op 6 maanden en is 100%
          medisch gekeurd &mdash; ger&ouml;ntgd en goedgekeurd voor sport &amp; fokkerij.
        </p>
        <a href="/mijn-fokkerij" class="text-link">Bekijk Luna &rarr;</a>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="cta-inner reveal">
      <h2 class="section-title">Interesse in een pup, dekreu of africhting?</h2>
      <a href="/contact" class="btn-primary">Neem contact op</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    max-width: 100%;
    padding: 11rem 3rem 6rem;
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    align-items: center;
    gap: 2rem;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      135deg,
      rgba(227, 30, 36, 0.04) 0px,
      rgba(227, 30, 36, 0.04) 2px,
      transparent 2px,
      transparent 16px
    );
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    animation: fadeUp 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .hero-title {
    font-family: var(--display);
    font-size: clamp(2.4rem, 5.5vw, 4.4rem);
    line-height: 1.05;
    margin: 0.6rem 0 1.5rem;
  }
  .hero-title em {
    color: var(--red);
    font-style: normal;
  }
  .hero-desc {
    font-family: var(--sans);
    font-size: 1.15rem;
    line-height: 1.8;
    color: rgba(242, 241, 237, 0.65);
    max-width: 560px;
    margin-bottom: 2.2rem;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .hero-mark {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 320px;
    justify-self: end;
    filter: drop-shadow(0 20px 50px rgba(227, 30, 36, 0.15));
    animation: fadeUp 1s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    padding-top: 0;
    padding-bottom: 4rem;
    border-bottom: 1px solid var(--line);
  }
  .fact {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    border-left: 2px solid var(--red);
    padding-left: 1.2rem;
  }
  .fact-num {
    font-family: var(--display);
    font-size: 2.2rem;
    font-weight: 600;
    color: var(--paper);
  }
  .fact-label {
    font-size: var(--text-sm);
    color: rgba(242, 241, 237, 0.55);
    line-height: 1.5;
  }

  .intro-grid,
  .breeding-grid {
    max-width: 680px;
  }

  .text-link {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--display);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--red);
    text-decoration: none;
    font-weight: 600;
  }
  .on-paper .text-link {
    color: var(--red);
  }
  .text-link:hover {
    color: var(--red-dark);
  }

  .cta {
    text-align: center;
    border-top: 1px solid var(--line);
  }
  .cta-inner {
    max-width: 620px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 9rem 1.5rem 3rem;
    }
    .hero-mark {
      max-width: 200px;
      justify-self: start;
    }
    .facts {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
