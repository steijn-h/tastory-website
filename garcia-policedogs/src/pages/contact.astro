---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout
  title="Contact — Garcia Policedogs"
  description="Neem contact op met Garcia Policedogs in Enschede voor vragen over africhting, fokkerij of de mogelijkheden voor een pup of dekreu."
>
  <PageHero
    kicker="Contact"
    title="Neem <em>contact</em> op"
    description="Vraag over africhting, een pup of een dekreu? Stuur een bericht of mail direct."
  />

  <section class="contact-content">
    <div class="contact-grid">
      <form class="contact-form reveal" id="contact-form" aria-label="Contactformulier">
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
        <div class="form-group">
          <label for="contact-name">Naam *</label>
          <input type="text" id="contact-name" name="name" required />
        </div>
        <div class="form-group">
          <label for="contact-email">E-mailadres *</label>
          <input type="email" id="contact-email" name="email" required />
        </div>
        <div class="form-group">
          <label for="contact-message">Bericht *</label>
          <textarea id="contact-message" name="message" rows="5" required></textarea>
        </div>
        <button type="submit" class="btn-primary">Verstuur bericht</button>
        <div class="contact-feedback" id="contact-feedback" role="status"></div>
      </form>

      <div class="contact-info reveal">
        <div class="info-card">
          <h3>Locatie</h3>
          <p>Enschede, Nederland</p>
        </div>
        <div class="info-card">
          <h3>E-mail</h3>
          <p><a href="mailto:info@garciapolicedogs.nl">info@garciapolicedogs.nl</a></p>
        </div>
        <div class="info-card">
          <h3>Social</h3>
          <p>
            <a href="https://facebook.com/Garciapolicedogs" target="_blank" rel="noopener"
              >Facebook</a
            ><br />
            <a href="https://instagram.com/Garciapolicedogs" target="_blank" rel="noopener"
              >Instagram</a
            >
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { submitForm } from '../utils/submitForm';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const feedback = document.getElementById('contact-feedback') as HTMLDivElement;
  const submitBtn = form.querySelector('button') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);

    submitBtn.disabled = true;
    submitBtn.textContent = 'Verzenden...';

    try {
      await submitForm({
        name: data.get('name') as string,
        email: data.get('email') as string,
        message: data.get('message') as string,
        _honey: data.get('_honey') as string,
        _subject: 'Nieuw bericht — garciapolicedogs.nl',
      });

      feedback.textContent = 'Bedankt voor je bericht! Ik neem zo snel mogelijk contact op.';
      feedback.className = 'contact-feedback contact-feedback--success';
      form.reset();
    } catch {
      feedback.textContent =
        'Er ging iets mis. Probeer het later opnieuw of mail naar info@garciapolicedogs.nl.';
      feedback.className = 'contact-feedback contact-feedback--error';
    }

    submitBtn.disabled = false;
    submitBtn.textContent = 'Verstuur bericht';

    setTimeout(() => {
      feedback.textContent = '';
      feedback.className = 'contact-feedback';
    }, 6000);
  });
</script>

<style>
  .contact-content {
    max-width: 1280px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .form-group label {
    font-family: var(--display);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(242, 241, 237, 0.6);
  }

  .form-group input,
  .form-group textarea {
    font-family: var(--sans);
    font-size: var(--text-base);
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--line);
    background: var(--black-panel);
    color: var(--paper);
    outline: none;
    transition: border-color 0.3s;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: var(--red);
  }

  .form-group textarea {
    resize: vertical;
  }

  .contact-feedback {
    font-size: var(--text-sm);
    min-height: 1.4rem;
  }

  .contact-feedback--success {
    color: #7fbf7f;
  }

  .contact-feedback--error {
    color: #e08585;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .info-card {
    background: var(--black-panel);
    border: 1px solid var(--line);
    border-left: 3px solid var(--red);
    padding: 1.6rem 1.8rem;
  }

  .info-card h3 {
    font-size: var(--text-base);
    letter-spacing: 0.1em;
    margin-bottom: 0.6rem;
  }

  .info-card p {
    font-family: var(--sans);
    font-size: var(--text-sm);
    line-height: 1.7;
    color: rgba(242, 241, 237, 0.65);
  }

  .info-card a {
    color: rgba(242, 241, 237, 0.8);
    text-decoration: none;
    transition: color 0.3s;
  }

  .info-card a:hover {
    color: var(--red);
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
